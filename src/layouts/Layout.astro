---
import '../styles/global.css';
import type { Locale } from '../lib/i18n';
import { getTranslations } from '../lib/i18n';
import { SITE_URL } from '../lib/constants';
import SearchModal from '../components/SearchModal.astro';

interface Props {
  title?: string;
  description?: string;
  lang: Locale;
  canonicalPath?: string;
  prevUrl?: string;
  nextUrl?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  lang,
  title,
  description,
  canonicalPath = Astro.url.pathname,
  prevUrl,
  nextUrl,
  noindex = false,
  jsonLd,
} = Astro.props;

const t = getTranslations(lang);
const pageTitle = title ? `${title} — tips.hub` : `tips.hub — ${t.site.title}`;
const pageDesc = description || t.site.description;

const otherLang: Locale = lang === 'vi' ? 'en' : 'vi';
const hasLocalizedCounterpart = /^\/(vi|en)(\/|$)/.test(canonicalPath);
const targetPath = canonicalPath === '/'
  ? `/${otherLang}`
  : hasLocalizedCounterpart
    ? canonicalPath.replace(new RegExp(`^/${lang}`), `/${otherLang}`)
    : `/${otherLang}`;
const viPath = lang === 'vi' ? canonicalPath : targetPath;
const viSwitchPath = hasLocalizedCounterpart ? (lang === 'vi' ? canonicalPath : targetPath) : '/vi';
const enSwitchPath = hasLocalizedCounterpart ? (lang === 'en' ? canonicalPath : targetPath) : '/en';
const alternateUrl = `${SITE_URL}${targetPath}`;
const canonicalUrl = `${SITE_URL}${canonicalPath}`;
const resolvedPrevUrl = prevUrl ? (prevUrl.startsWith('http') ? prevUrl : `${SITE_URL}${prevUrl}`) : undefined;
const resolvedNextUrl = nextUrl ? (nextUrl.startsWith('http') ? nextUrl : `${SITE_URL}${nextUrl}`) : undefined;
const ogImageAlt = lang === 'vi'
  ? 'tips.hub — Sổ tay thủ thuật & mẹo công nghệ'
  : 'tips.hub — Practical tech tips & tricks notebook';
const ogLocale = lang === 'vi' ? 'vi_VN' : 'en_US';
const ogLocaleAlternate = lang === 'vi' ? 'en_US' : 'vi_VN';
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const isHome = canonicalPath === `/${lang}` || canonicalPath === `/${lang}/`;
const isNews = canonicalPath.includes('/news');
const isSaved = canonicalPath.includes('/saved');
const isSources = canonicalPath.includes('/sources');
const isSubmit = canonicalPath.includes('/submit');
const isAbout = canonicalPath.includes('/about');
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0F1114" />
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('techtips_theme') === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
            var meta = document.querySelector('meta[name="theme-color"]');
            if (meta) meta.setAttribute('content', '#F7F6F2');
          }
        } catch (e) {}
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    {hasLocalizedCounterpart && <link rel="alternate" hreflang={lang} href={canonicalUrl} />}
    {hasLocalizedCounterpart && <link rel="alternate" hreflang={otherLang} href={alternateUrl} />}
    {hasLocalizedCounterpart && <link rel="alternate" hreflang="x-default" href={`${SITE_URL}${viPath}`} />}
    <link rel="alternate" type="application/rss+xml" title={`${t.site.title} RSS`} href={`/${lang}/feed.xml`} />
    {resolvedPrevUrl && <link rel="prev" href={resolvedPrevUrl} />}
    {resolvedNextUrl && <link rel="next" href={resolvedNextUrl} />}

    <!-- Open Graph & Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="tips.hub" />
    <meta property="og:image" content={`${SITE_URL}/og-image.png`} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={`${SITE_URL}/og-image.png`} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Favicon & PWA -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Structured Data (JSON-LD) -->
    {jsonLdItems.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029')} />
    ))}

    <!-- Google Fonts with Vietnamese Subset -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&family=Lexend:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex flex-col min-h-screen bg-[var(--bg-primary)] text-[var(--text-primary)] font-sans antialiased pb-20 md:pb-0">
    <!-- Accessibility Skip Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 px-4 py-2 bg-[var(--accent)] text-[var(--on-accent)] rounded-md font-bold shadow-lg"
    >
      {lang === 'vi' ? 'Bỏ qua và chuyển tới nội dung chính' : 'Skip to main content'}
    </a>

    <!-- Top Navigation Header -->
    <header class="sticky top-0 z-40 bg-[var(--bg-primary)]/95 backdrop-blur-md border-b border-[var(--border-color)]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-4">
        <!-- Left: Brand Logo & Links -->
        <div class="flex items-center gap-6 lg:gap-8">
          <a href={`/${lang}`} class="inline-flex items-center gap-2 group shrink-0">
            <span class="w-2.5 h-2.5 rounded-full bg-[var(--accent-hero)] shadow-sm"></span>
            <span class="font-bold text-base tracking-tight text-[var(--text-primary)] font-mono">
              tips.hub
            </span>
          </a>

          <!-- Nav Links (Desktop) -->
          <nav class="hidden md:flex items-center gap-5 lg:gap-6 text-xs font-mono font-medium" aria-label={lang === 'vi' ? 'Điều hướng chính' : 'Main navigation'}>
            <a
              href={`/${lang}`}
              class={`transition-colors hover:text-[var(--text-primary)] ${isHome ? 'text-[var(--text-primary)] font-bold' : 'text-[var(--text-muted)]'}`}
            >
              {t.nav.home}
            </a>
            <a
              href={`/${lang}/news`}
              class={`transition-colors hover:text-[var(--text-primary)] ${isNews ? 'text-[var(--text-primary)] font-bold' : 'text-[var(--text-muted)]'}`}
            >
              {lang === 'vi' ? 'Tin công nghệ' : 'Tech News'}
            </a>
            <a
              href={`/${lang}/saved`}
              class={`transition-colors hover:text-[var(--text-primary)] ${isSaved ? 'text-[var(--text-primary)] font-bold' : 'text-[var(--text-muted)]'}`}
            >
              {t.nav.saved}
            </a>
            <a
              href={`/${lang}/sources`}
              class={`transition-colors hover:text-[var(--text-primary)] ${isSources ? 'text-[var(--text-primary)] font-bold' : 'text-[var(--text-muted)]'}`}
            >
              {t.nav.sources}
            </a>
            <a
              href={`/${lang}/submit`}
              class={`transition-colors hover:text-[var(--text-primary)] ${isSubmit ? 'text-[var(--text-primary)] font-bold' : 'text-[var(--text-muted)]'}`}
            >
              {t.nav.submit}
            </a>
            <a
              href={`/${lang}/about`}
              class={`transition-colors hover:text-[var(--text-primary)] ${isAbout ? 'text-[var(--text-primary)] font-bold' : 'text-[var(--text-muted)]'}`}
            >
              {t.nav.about}
            </a>
          </nav>
        </div>

        <!-- Right: Search trigger, Theme Toggle & Language Switcher Pill -->
        <div class="flex items-center gap-2 sm:gap-2.5">
          <!-- Search Pill (Desktop) -->
          <button
            id="open-search-btn"
            type="button"
            class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-muted)] hover:border-[var(--border-strong)] hover:text-[var(--text-secondary)] transition-all text-xs font-mono"
            aria-label={t.nav.search}
          >
            <span class="text-[var(--accent)] font-bold">$</span>
            <span>{lang === 'vi' ? 'Tìm thủ thuật...' : 'Search tips...'}</span>
            <kbd class="ml-1.5 text-[10px] bg-[var(--bg-muted)] border-[var(--border-subtle)]">/</kbd>
          </button>

          <!-- Search icon (mobile only) -->
          <button
            id="open-search-btn-mobile"
            type="button"
            class="sm:hidden inline-flex items-center justify-center w-9 h-9 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-colors"
            aria-label={t.nav.search}
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="7" stroke-width="2"></circle>
              <line x1="16.5" y1="16.5" x2="21" y2="21" stroke-width="2" stroke-linecap="round"></line>
            </svg>
          </button>

          <!-- Theme Toggle Button (Dark Terminal default <-> Light Editorial) -->
          <button
            type="button"
            data-theme-toggle
            aria-label={t.nav.toggle_theme}
            title={t.nav.toggle_theme}
            aria-pressed="false"
            class="inline-flex items-center justify-center w-9 h-9 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] hover:text-[var(--text-primary)] transition-colors"
          >
            <svg data-theme-icon="sun" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4" stroke-width="2"></circle>
              <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41m11.32-11.32 1.41-1.41" stroke-width="2" stroke-linecap="round"></path>
            </svg>
            <svg data-theme-icon="moon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>

          <!-- Language Segmented Switcher Pill (VI | EN) -->
          <div class="inline-flex items-center p-0.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] text-xs font-mono font-bold">
            <a
              href={viSwitchPath}
              aria-current={lang === 'vi' ? 'page' : undefined}
              data-set-lang="vi"
              class={`px-2.5 sm:px-3 py-1.5 min-h-[36px] flex items-center rounded-lg transition-all ${lang === 'vi' ? 'bg-[var(--accent-hero)] text-[#15110A] font-extrabold shadow-sm' : 'text-[var(--text-muted)] hover:text-[var(--text-primary)]'}`}
              aria-label="Chuyển sang Tiếng Việt"
            >
              VI
            </a>
            <a
              href={enSwitchPath}
              aria-current={lang === 'en' ? 'page' : undefined}
              data-set-lang="en"
              class={`px-2.5 sm:px-3 py-1.5 min-h-[36px] flex items-center rounded-lg transition-all ${lang === 'en' ? 'bg-[var(--accent-hero)] text-[#15110A] font-extrabold shadow-sm' : 'text-[var(--text-muted)] hover:text-[var(--text-primary)]'}`}
              aria-label="Switch to English"
            >
              EN
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content Area -->
    <main id="main-content" class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-8">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="mt-auto border-t border-[var(--border-color)] bg-[var(--bg-primary)] py-8 transition-colors text-xs text-[var(--text-muted)]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="space-y-1 text-center md:text-left leading-relaxed">
          <p>
            {lang === 'vi'
              ? 'Tech Tips Hub chỉ hiển thị tiêu đề, tóm tắt ngắn và liên kết về nguồn gốc; bản quyền thuộc về tác giả.'
              : 'Tech Tips Hub only displays titles, short summaries and source links; copyright belongs to original authors.'}
          </p>
          <p>
            {lang === 'vi'
              ? 'Bản dịch tự động có thể chưa chính xác.'
              : 'Machine translations may not be completely accurate.'}
          </p>
        </div>

        <div class="flex items-center justify-center flex-wrap gap-x-5 gap-y-2 shrink-0 font-medium">
          <a href={`/${lang}/submit`} class="hover:text-[var(--text-primary)] transition-colors">
            {lang === 'vi' ? 'Gửi mẹo' : 'Submit Tip'}
          </a>
          <a href={`/${lang}/feed.xml`} class="hover:text-[var(--text-primary)] transition-colors inline-flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-[var(--accent)]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 11a9 9 0 0 1 9 9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M4 4a16 16 0 0 1 16 16" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              <circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none"></circle>
            </svg>
            <span>RSS</span>
          </a>
          <a href={`/${lang}/copyright`} class="hover:text-[var(--text-primary)] transition-colors">
            {lang === 'vi' ? 'Bản quyền và gỡ bài' : 'Copyright & Takedown'}
          </a>
          <a href={`/${lang}/privacy`} class="hover:text-[var(--text-primary)] transition-colors">
            {lang === 'vi' ? 'Quyền riêng tư' : 'Privacy'}
          </a>
          <a
            href="https://github.com/nhattranhuynhthien/tech-tips-hub"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-[var(--text-primary)] transition-colors inline-flex items-center gap-1"
          >
            <span>{lang === 'vi' ? 'Mã nguồn mở' : 'Open Source'}</span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
              <polyline points="15 3 21 3 21 9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polyline>
              <line x1="10" y1="14" x2="21" y2="3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></line>
            </svg>
          </a>
        </div>
      </div>
    </footer>

    <!-- Fixed Mobile Bottom Navigation Bar -->
    <nav class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-[var(--bg-primary)]/95 backdrop-blur-lg border-t border-[var(--border-color)] h-16 flex items-center justify-between text-[10px] font-mono px-1" aria-label={lang === 'vi' ? 'Điều hướng di động' : 'Mobile navigation'}>
      <a
        href={`/${lang}`}
        class={`flex-1 min-w-0 flex flex-col items-center justify-center gap-1 py-1.5 px-1 rounded-lg transition-colors whitespace-nowrap leading-none ${isHome ? 'text-[var(--accent)] font-bold' : 'text-[var(--text-muted)]'}`}
      >
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="truncate max-w-full">{t.nav.home}</span>
      </a>

      <a
        href={`/${lang}/news`}
        class={`flex-1 min-w-0 flex flex-col items-center justify-center gap-1 py-1.5 px-1 rounded-lg transition-colors whitespace-nowrap leading-none ${isNews ? 'text-[var(--accent)] font-bold' : 'text-[var(--text-muted)]'}`}
      >
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M10 6h8M10 10h8M10 14h4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="truncate max-w-full">{lang === 'vi' ? 'Tin tức' : 'News'}</span>
      </a>

      <a
        href={`/${lang}/saved`}
        class={`flex-1 min-w-0 flex flex-col items-center justify-center gap-1 py-1.5 px-1 rounded-lg transition-colors whitespace-nowrap leading-none ${isSaved ? 'text-[var(--accent)] font-bold' : 'text-[var(--text-muted)]'}`}
      >
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="truncate max-w-full">{t.nav.saved}</span>
      </a>

      <a
        href={`/${lang}/sources`}
        class={`flex-1 min-w-0 flex flex-col items-center justify-center gap-1 py-1.5 px-1 rounded-lg transition-colors whitespace-nowrap leading-none ${isSources ? 'text-[var(--accent)] font-bold' : 'text-[var(--text-muted)]'}`}
      >
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="truncate max-w-full">{t.nav.sources}</span>
      </a>

      <a
        href={`/${lang}/about`}
        class={`flex-1 min-w-0 flex flex-col items-center justify-center gap-1 py-1.5 px-1 rounded-lg transition-colors whitespace-nowrap leading-none ${isAbout ? 'text-[var(--accent)] font-bold' : 'text-[var(--text-muted)]'}`}
      >
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="10" stroke-width="2"></circle>
          <line x1="12" y1="16" x2="12" y2="12" stroke-width="2" stroke-linecap="round"></line>
          <line x1="12" y1="8" x2="12.01" y2="8" stroke-width="2" stroke-linecap="round"></line>
        </svg>
        <span class="truncate max-w-full">{t.nav.about}</span>
      </a>
    </nav>

    <!-- Global Client Search Modal -->
    <SearchModal lang={lang} />

    <!-- Global Actions: Bookmarks, Theme Toggle, Favicon Fallback, Toast -->
    <script src="/js/actions.js" is:inline></script>

    <!-- Register PWA Service Worker -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
