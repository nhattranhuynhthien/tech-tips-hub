---
import CategoryPage from '../../../components/pages/CategoryPage.astro';
import { getAllCategories, getAllTips, sortTipsNewestFirst, type Category, type Tip } from '../../../lib/data';

export async function getStaticPaths() {
  const categories = getAllCategories();
  const tips = sortTipsNewestFirst(getAllTips().filter((t) => t.source.kind !== 'news'));

  return categories.map((cat) => ({
    params: { category: cat.id },
    props: {
      category: cat,
      tips: tips.filter((t) => t.categories.includes(cat.id)),
    },
  }));
}

interface Props {
  category: Category;
  tips: Tip[];
}

const { category, tips } = Astro.props;
---

<CategoryPage lang="en" category={category} tips={tips} />
