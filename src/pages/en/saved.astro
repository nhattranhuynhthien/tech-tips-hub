---
import Layout from '../../layouts/Layout.astro';
import { getTranslations } from '../../lib/i18n';

const lang = 'en';
const t = getTranslations(lang);
---

<Layout lang={lang} title="Saved Tips" description="Tech tricks and articles bookmarked in your browser.">
  <div class="max-w-4xl mx-auto">
    <!-- Header with Command Prompt -->
    <header class="mb-8">
      <div class="text-xs font-mono font-bold text-[var(--accent)] mb-2">
        $ ls saved/
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--text-primary)] tracking-tight mb-2">
        Saved Tips
      </h1>
      <p class="text-xs sm:text-sm text-[var(--text-secondary)] font-mono leading-relaxed max-w-xl" id="saved-counter">
        Loading saved tips from your browser storage...
      </p>
    </header>

    <!-- Empty State -->
    <div id="saved-empty-state" class="hidden py-16 text-center border border-dashed border-[var(--border-color)] rounded-xl bg-[var(--bg-surface)]">
      <div class="w-12 h-12 mx-auto rounded-full bg-[var(--bg-muted)] flex items-center justify-center text-[var(--text-muted)] mb-3">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
      <h3 class="text-base font-bold text-[var(--text-primary)] mb-2 font-mono">
        No saved tips yet
      </h3>
      <p class="text-xs text-[var(--text-muted)] font-mono mb-4">
        Bookmark tips you want to reference later and they will appear here.
      </p>
      <a
        href={`/${lang}`}
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-mono font-bold bg-[var(--accent-hero)] text-black shadow-sm"
      >
        <span>Explore tips</span>
      </a>
    </div>

    <!-- Cards are rendered client-side from localStorage + /api/tips.json -->
    <div id="saved-stream" class="space-y-4"></div>
  </div>
</Layout>

<script is:inline define:vars={{ lang }}>
  (function () {
    const SAVED_KEY = 'techtips_saved';
    const stream = document.getElementById('saved-stream');
    const emptyState = document.getElementById('saved-empty-state');
    const counter = document.getElementById('saved-counter');
    let tipsById = null;

    function getSaved() {
      try {
        return JSON.parse(localStorage.getItem(SAVED_KEY)) || [];
      } catch {
        return [];
      }
    }

    async function loadTips() {
      if (tipsById) return tipsById;
      const resp = await fetch('/api/tips.json');
      if (!resp.ok) throw new Error('Cannot load tips');
      const list = await resp.json();
      tipsById = new Map(list.map((tip) => [tip.id, tip]));
      return tipsById;
    }

    function createCard(tip) {
      const article = document.createElement('article');
      article.className = 'bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--border-strong)] rounded-xl p-5 transition-all flex flex-col gap-3';
      article.setAttribute('data-tip-id', tip.id);

      const meta = document.createElement('div');
      meta.className = 'flex items-center gap-2 text-xs font-mono text-[var(--text-muted)] flex-wrap';

      const source = document.createElement('span');
      source.className = 'text-[var(--text-secondary)] font-medium lowercase';
      source.textContent = tip.source?.name || '';

      const dot = document.createElement('span');
      dot.textContent = '·';

      const category = document.createElement('span');
      category.className = 'lowercase text-[var(--accent)]';
      category.textContent = (tip.categories || [])[0] || 'tips';

      meta.append(source, dot, category);

      const heading = document.createElement('h2');
      heading.className = 'text-base sm:text-lg font-bold leading-snug text-[var(--text-primary)]';

      const link = document.createElement('a');
      link.href = `/${lang}/tip/${encodeURIComponent(tip.slug || tip.id)}`;
      link.className = 'hover:text-[var(--accent)] transition-colors';
      link.textContent = tip.title?.[lang] || tip.title?.en || '';
      heading.appendChild(link);

      const summary = document.createElement('p');
      summary.className = 'text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed line-clamp-2';
      summary.textContent = tip.summary?.[lang] || tip.summary?.en || '';

      const footer = document.createElement('div');
      footer.className = 'pt-3 border-t border-[var(--border-subtle)] flex items-center justify-between gap-2 text-xs font-mono';

      const detail = document.createElement('a');
      detail.href = link.href;
      detail.className = 'text-[var(--accent)] hover:underline font-semibold';
      detail.textContent = 'View details →';

      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'bookmark-btn px-2.5 py-1 rounded-lg border border-[var(--accent)] text-[var(--accent)] hover:bg-[var(--bg-muted)] transition-colors';
      remove.setAttribute('data-id', tip.id);
      remove.setAttribute('aria-pressed', 'true');
      remove.textContent = 'Remove';

      footer.append(detail, remove);
      article.append(meta, heading, summary, footer);
      return article;
    }

    async function renderSaved() {
      if (!stream || !emptyState || !counter) return;

      const saved = getSaved();
      stream.replaceChildren();
      emptyState.classList.add('hidden');

      if (!saved.length) {
        counter.textContent = 'You have not saved any tips in this browser yet.';
        emptyState.classList.remove('hidden');
        return;
      }

      try {
        const map = await loadTips();
        const items = saved.map((id) => map.get(id)).filter(Boolean);
        items.forEach((tip) => stream.appendChild(createCard(tip)));

        counter.textContent = `You have ${items.length} tips stored locally in your browser.`;
        if (!items.length) emptyState.classList.remove('hidden');
      } catch {
        counter.textContent = 'Could not load saved tips. Please try again.';
      }
    }

    renderSaved();
    window.addEventListener('storage', renderSaved);
    window.addEventListener('techtips:bookmark_changed', renderSaved);
  })();
</script>
