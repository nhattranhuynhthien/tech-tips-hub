---
import Layout from '../../layouts/Layout.astro';
import { getTranslations } from '../../lib/i18n';
const lang = 'en';
const t = getTranslations(lang);
const issueUrl = 'https://github.com/nhattranhuynhthien/tech-tips-hub/issues/new?template=community-tip.yml';
---

<Layout lang={lang} title="Submit a tech tip" description="Suggest a short, sourced technology tip for moderator review.">
  <article class="max-w-3xl mx-auto space-y-5">
    <p class="text-xs font-mono font-bold text-[var(--accent)]">$ community/inbox</p>
    <h1 class="text-3xl font-extrabold text-[var(--text-primary)]">Submit a tech tip</h1>
    <p class="text-sm leading-relaxed text-[var(--text-secondary)]">Share a title, a short practical explanation, and the original source link when available. A moderator reviews each submission; unapproved tips will not appear on the site.</p>
    <p class="text-sm leading-relaxed text-[var(--text-secondary)]">Do not paste full articles. A display name is optional, and the form lets you choose whether it may be shown as attribution.</p>
    <a href={issueUrl} target="_blank" rel="noopener noreferrer" class="inline-flex rounded-xl bg-[var(--accent-hero)] px-4 py-2 text-sm font-bold text-black">Open the GitHub submission form ↗</a>
  </article>
</Layout>
