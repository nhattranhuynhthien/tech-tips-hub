---
import type { GetStaticPaths, Page } from 'astro';
import PaginatedFeedPage from '../../../components/pages/PaginatedFeedPage.astro';
import { getAllTips, getTrickOfTheDay, sortTipsNewestFirst, type Tip } from '../../../lib/data';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const allTips = getAllTips(false).filter((tip) => tip.source.kind !== 'news');
  const trickOfDay = getTrickOfTheDay('en');
  const tips = trickOfDay ? allTips.filter((tip) => tip.id !== trickOfDay.id) : allTips;
  return paginate(sortTipsNewestFirst(tips), { pageSize: 20 });
};

interface Props {
  page: Page<Tip>;
}

const { page } = Astro.props;
---

<PaginatedFeedPage lang="en" page={page} />
