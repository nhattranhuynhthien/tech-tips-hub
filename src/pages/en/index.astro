---
import Layout from '../../layouts/Layout.astro';
import TipCard from '../../components/TipCard.astro';
import TrickOfTheDay from '../../components/TrickOfTheDay.astro';
import Pagination from '../../components/Pagination.astro';
import { getAllTips, getTrickOfTheDay, getAllCategories, getAllSources, sortTipsNewestFirst } from '../../lib/data';
import { getTranslations } from '../../lib/i18n';

const lang = 'en';
const t = getTranslations(lang);
const rawTips = getAllTips(false).filter((tip) => tip.source.kind !== 'news');
const trickOfDay = getTrickOfTheDay();
const tips = trickOfDay ? rawTips.filter((t) => t.id !== trickOfDay.id) : rawTips;
const allCategories = getAllCategories();
const sources = getAllSources();
const latestUpdate = rawTips.map((tip) => tip.fetched_at).filter(Boolean).sort().at(-1) || '';
const contentTypes = [
  { id: 'article', label: 'Articles' },
  { id: 'community', label: 'Community' },
  { id: 'video', label: 'Video' },
  { id: 'vendor', label: 'Technology vendors' },
];
// Only the first page is pre-rendered; the rest is loaded from /api/tips.json on interaction.
const PAGE_SIZE = 20;
const orderedTips = sortTipsNewestFirst(tips);
const initialTips = orderedTips.slice(0, PAGE_SIZE);
const totalPages = Math.ceil(orderedTips.length / PAGE_SIZE);
const cardLabels = {
  difficulty: t.difficulty,
  contentTypes: { community: 'Community', video: 'Video', vendor: 'Vendor', article: 'Article' },
  notTranslated: 'Not translated',
  machineTranslated: 'Machine translated',
  community: 'Community',
  moreSources: 'more sources',
  updated: 'updated',
  readOriginal: 'Read original',
  original: 'Original',
};

// List of categories for sidebar matching Page 1
const sidebarCategories = [
  { id: 'all', label: '# all' },
  { id: 'windows', label: '# windows' },
  { id: 'macos', label: '# macos' },
  { id: 'linux', label: '# linux' },
  { id: 'android', label: '# android' },
  { id: 'ios', label: '# ios' },
  { id: 'security', label: '# security' },
  { id: 'dev', label: '# dev & devops' },
  { id: 'hardware', label: '# hardware' },
  { id: 'browser', label: '# browser' },
  { id: 'office', label: '# office' },
  { id: 'ai', label: '# ai' },
];
---

<Layout lang={lang} title={t.site.tagline} nextUrl={totalPages > 1 ? `/${lang}/page/2` : undefined}>
  <script is:inline src="/js/tip-card.js"></script>
  <h1 class="sr-only">Tech Tips Hub — the latest practical tech tips and tricks</h1>
  <!-- Mobile Search Bar (Matching Mockup Page 2) -->
  <div class="sm:hidden mb-4">
    <div class="relative">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[var(--accent)] font-mono font-bold">
        $
      </div>
      <input
        id="mobile-search-input"
        type="search"
        placeholder="Search tips..."
        class="w-full pl-8 pr-4 py-2 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] text-sm text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:border-[var(--accent)] shadow-sm font-mono"
      />
    </div>
  </div>

  {latestUpdate && <p class="text-[11px] text-[var(--text-muted)] font-mono mb-4">Latest update: <time datetime={latestUpdate}>{new Date(latestUpdate).toLocaleString('en-US')}</time></p>}

  <!-- Mobile Horizontal Category Scroll (Matching Mockup Page 2) -->
  <div class="md:hidden flex items-center gap-2 overflow-x-auto pb-3 mb-6 scrollbar-none" id="mobile-category-bar">
    {sidebarCategories.map((cat, idx) => (
      <button
        type="button"
        class={`mobile-cat-btn shrink-0 px-3.5 py-1.5 rounded-xl text-xs font-mono font-semibold transition-all ${
          idx === 0
            ? 'bg-[var(--accent-hero)] text-black font-bold shadow-sm'
            : 'border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)]'
        }`}
        data-category={cat.id}
      >
        {cat.id === 'all' ? 'all' : cat.id}
      </button>
    ))}
  </div>

  <!-- Trick of the Day (Matching Mockup Page 1 & 2) -->
  {trickOfDay && <TrickOfTheDay tip={trickOfDay} lang={lang} />}

  <!-- Main 2-Column Content Layout (Matching Mockup Page 1) -->
  <div class="flex flex-col md:flex-row items-start gap-8 lg:gap-12">
    <!-- Left Sidebar: Categories, Difficulty, Sort (Desktop) -->
    <aside class="w-48 lg:w-56 shrink-0 hidden md:block space-y-7 sticky top-20 text-xs font-mono">
      <!-- 1. Categories -->
      <div>
        <h3 class="text-[11px] font-bold uppercase tracking-wider text-[var(--text-muted)] mb-3">
          CATEGORIES
        </h3>
        <ul class="space-y-1.5" id="desktop-category-list">
          {sidebarCategories.map((cat, idx) => (
            <li>
              <button
                type="button"
                class={`desktop-cat-btn text-left w-full py-1 transition-colors ${
                  idx === 0
                    ? 'text-[var(--accent)] font-bold'
                    : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)]'
                }`}
                data-category={cat.id}
              >
                {cat.label}
              </button>
            </li>
          ))}
        </ul>
      </div>

      <!-- 2. Difficulty -->
      <div>
        <h3 class="text-[11px] font-bold uppercase tracking-wider text-[var(--text-muted)] mb-2.5">
          DIFFICULTY
        </h3>
        <div class="flex items-center gap-1.5 flex-wrap" id="desktop-diff-group">
          <button
            type="button"
            class="diff-pill-btn px-2.5 py-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--text-primary)] transition-all"
            data-diff="all"
          >
            All
          </button>
          <button
            type="button"
            class="diff-pill-btn px-2.5 py-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all"
            data-diff="easy"
          >
            Easy
          </button>
          <button
            type="button"
            class="diff-pill-btn px-2.5 py-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all"
            data-diff="medium"
          >
            Medium
          </button>
          <button
            type="button"
            class="diff-pill-btn px-2.5 py-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all"
            data-diff="advanced"
          >
            Advanced
          </button>
        </div>
      </div>

      <!-- 3. Sort -->
      <div>
        <h3 class="text-[11px] font-bold uppercase tracking-wider text-[var(--text-muted)] mb-2.5">
          SORT
        </h3>
        <div class="inline-flex p-0.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] text-xs" id="desktop-sort-group">
          <button
            type="button"
            class="sort-pill-btn px-3 py-1 rounded-lg transition-all text-[var(--text-muted)] hover:text-[var(--text-primary)]"
            data-sort="best"
          >
            Best
          </button>
          <button
            type="button"
            class="sort-pill-btn px-3 py-1 rounded-lg transition-all bg-[var(--accent-hero)] text-black font-bold shadow-sm"
            data-sort="newest"
          >
            Newest
          </button>
        </div>
      </div>
    </aside>

    <!-- Right Stream: Tips List & Pagination -->
    <div class="flex-1 w-full min-w-0">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-2 mb-4" aria-label="Article filters">
        <label class="text-[10px] font-mono text-[var(--text-muted)]">SOURCE
          <select id="source-filter" class="mt-1 w-full rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] p-2 text-xs text-[var(--text-primary)]">
            <option value="all">All sources</option>
            <option value="community">Community contributions</option>
            {sources.map((source) => <option value={source.id}>{source.name}</option>)}
          </select>
        </label>
        <label class="text-[10px] font-mono text-[var(--text-muted)]">CONTENT TYPE
          <select id="content-type-filter" class="mt-1 w-full rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] p-2 text-xs text-[var(--text-primary)]">
            <option value="all">All types</option>
            {contentTypes.map((type) => <option value={type.id}>{type.label}</option>)}
          </select>
        </label>
        <label class="text-[10px] font-mono text-[var(--text-muted)]">PLATFORM
          <select id="platform-filter" class="mt-1 w-full rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] p-2 text-xs text-[var(--text-primary)]">
            <option value="all">All platforms</option>
            {allCategories.map((category) => <option value={category.id}>{category.name.en}</option>)}
          </select>
        </label>
        <label class="text-[10px] font-mono text-[var(--text-muted)]">ORIGINAL LANGUAGE
          <select id="language-filter" class="mt-1 w-full rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] p-2 text-xs text-[var(--text-primary)]">
            <option value="all">All languages</option>
            <option value="en">English</option>
            <option value="vi">Vietnamese</option>
          </select>
        </label>
      </div>
      <!-- Tips List Container -->
      <div id="tips-stream" class="space-y-4">
        {initialTips.map((tip) => (
          <TipCard tip={tip} lang={lang} />
        ))}
      </div>

      <!-- Empty state when search or filter has no match -->
      <div id="empty-stream-msg" class="hidden py-16 text-center border border-dashed border-[var(--border-color)] rounded-xl bg-[var(--bg-surface)]">
        <p class="text-sm font-mono text-[var(--text-secondary)] mb-3">
          No tips found matching the selected filters.
        </p>
        <button
          id="reset-filter-btn"
          type="button"
          class="px-4 py-2 rounded-xl text-xs font-mono font-bold bg-[var(--accent-hero)] text-black"
        >
          Clear filters
        </button>
      </div>

      <!-- Server-rendered Pagination with Astro paginate links -->
      <div id="static-pagination">
        <Pagination
          currentPage={1}
          lastPage={totalPages}
          totalItems={orderedTips.length}
          pageSize={20}
          basePath={`/${lang}`}
          lang={lang}
        />
      </div>

      <!-- Client-side Dynamic Pagination Controls (Shown when JS active / filtering) -->
      <nav id="dynamic-pagination" aria-label="Filtered pagination" class="hidden mt-12 flex flex-col items-center gap-3 font-mono text-xs">
        <div class="flex items-center gap-2">
          <button
            id="page-prev-btn"
            type="button"
            class="h-11 px-4 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-primary)] hover:border-[var(--accent)] hover:text-[var(--accent)] disabled:opacity-50 disabled:cursor-not-allowed transition-all flex items-center gap-1.5"
          >
            ← Prev
          </button>
          <div id="page-numbers" class="flex items-center gap-1"></div>
          <button
            id="page-next-btn"
            type="button"
            class="h-11 px-4 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-primary)] hover:border-[var(--accent)] hover:text-[var(--accent)] disabled:opacity-50 disabled:cursor-not-allowed transition-all flex items-center gap-1.5"
          >
            Next →
          </button>
        </div>
        <div id="pagination-subtext" class="text-[11px] text-[var(--text-muted)]"></div>
      </nav>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ lang, cardLabels, trickId: trickOfDay?.id || '', pageSize: PAGE_SIZE }}>
  (function () {
    const ITEMS_PER_PAGE = pageSize;
    const LANG = lang;
    const LABELS = cardLabels;

    let allTips = null;
    let loadPromise = null;
    let clientMode = false;
    let renderToken = 0;
    let lastTotal = 0;

    let currentPage = 1;
    let currentCat = 'all';
    let currentDiff = 'all';
    let currentLangFilter = 'all';
    let currentSource = 'all';
    let currentType = 'all';
    let currentSort = 'newest';
    let searchQuery = '';

    const stream = document.getElementById('tips-stream');
    const emptyMsg = document.getElementById('empty-stream-msg');
    const resetBtn = document.getElementById('reset-filter-btn');
    const staticPagination = document.getElementById('static-pagination');
    const dynamicPagination = document.getElementById('dynamic-pagination');

    const mobileCatBtns = Array.from(document.querySelectorAll('.mobile-cat-btn'));
    const desktopCatBtns = Array.from(document.querySelectorAll('.desktop-cat-btn'));
    const diffBtns = Array.from(document.querySelectorAll('.diff-pill-btn'));
    const langBtns = Array.from(document.querySelectorAll('.lang-pill-btn'));
    const sortBtns = Array.from(document.querySelectorAll('.sort-pill-btn'));
    const mobileSearchInput = document.getElementById('mobile-search-input');
    const sourceFilter = document.getElementById('source-filter');
    const typeFilter = document.getElementById('content-type-filter');
    const platformFilter = document.getElementById('platform-filter');
    const languageFilter = document.getElementById('language-filter');

    const pagePrevBtn = document.getElementById('page-prev-btn');
    const pageNextBtn = document.getElementById('page-next-btn');
    const pageNumbersContainer = document.getElementById('page-numbers');
    const paginationSubtext = document.getElementById('pagination-subtext');

    const CAT_MOBILE_BASE = 'mobile-cat-btn shrink-0 px-3.5 py-1.5 rounded-xl text-xs font-mono font-semibold transition-all border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)]';
    const CAT_MOBILE_ACTIVE = 'mobile-cat-btn shrink-0 px-3.5 py-1.5 rounded-xl text-xs font-mono font-semibold transition-all bg-[var(--accent-hero)] text-black font-bold shadow-sm';
    const CAT_DESKTOP_BASE = 'desktop-cat-btn text-left w-full py-1 transition-colors text-[var(--text-secondary)] hover:text-[var(--text-primary)]';
    const CAT_DESKTOP_ACTIVE = 'desktop-cat-btn text-left w-full py-1 transition-colors text-[var(--accent)] font-bold';
    const DIFF_BASE = 'diff-pill-btn px-2.5 py-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all';
    const DIFF_ACTIVE = 'diff-pill-btn px-2.5 py-1 rounded-lg border border-[var(--accent)] bg-[var(--accent-bg)] text-[var(--accent)] font-bold transition-all';
    const LANG_BASE = 'lang-pill-btn px-2.5 py-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] text-xs transition-all';
    const LANG_ACTIVE = 'lang-pill-btn px-2.5 py-1 rounded-lg border border-[var(--accent)] bg-[var(--accent-hero)] text-black font-semibold text-xs transition-all shadow-sm';
    const SORT_BASE = 'sort-pill-btn px-3 py-1 rounded-lg transition-all text-[var(--text-muted)] hover:text-[var(--text-primary)]';
    const SORT_ACTIVE = 'sort-pill-btn px-3 py-1 rounded-lg transition-all bg-[var(--accent-hero)] text-black font-bold shadow-sm';

    function timeOf(tip) {
      return new Date(tip.published_at || tip.fetched_at || 0).getTime() || 0;
    }

    function compareFeed(a, b) {
      const scoreDiff = (b.score || 0) - (a.score || 0);
      if (scoreDiff !== 0) return scoreDiff;
      const timeDiff = timeOf(b) - timeOf(a);
      if (timeDiff !== 0) return timeDiff;
      const aId = String(a.id || '');
      const bId = String(b.id || '');
      return aId < bId ? -1 : aId > bId ? 1 : 0;
    }

    function compareNewest(a, b) {
      return timeOf(b) - timeOf(a);
    }

    function searchText(tip) {
      const title = (tip.title && (tip.title[LANG] || tip.title.en)) || '';
      const summary = (tip.summary && (tip.summary[LANG] || tip.summary.en)) || '';
      const sourceName = (tip.source && tip.source.name) || '';
      return `${title} ${summary} ${sourceName} ${(tip.categories || []).join(' ')}`.toLowerCase();
    }

    function matches(tip) {
      const q = searchQuery.toLowerCase().trim();
      const cats = tip.categories || [];
      const diff = tip.difficulty || '';
      const originalLang = tip.original_lang || 'en';
      const sourceId = (tip.source && tip.source.id) || '';
      const contentType = (tip.source && tip.source.content_type) || 'article';

      const matchCat = currentCat === 'all' || cats.indexOf(currentCat) !== -1;
      const matchDiff = currentDiff === 'all' || diff === currentDiff;
      const matchLang = currentLangFilter === 'all' || originalLang === currentLangFilter;
      const matchSource = currentSource === 'all' || sourceId === currentSource;
      const matchType = currentType === 'all' || contentType === currentType;
      const matchSearch = !q || searchText(tip).indexOf(q) !== -1;

      return matchCat && matchDiff && matchLang && matchSource && matchType && matchSearch;
    }

    function ensureTips() {
      if (allTips) return Promise.resolve(allTips);
      if (!loadPromise) {
        loadPromise = fetch('/api/tips.json')
          .then((resp) => {
            if (!resp.ok) throw new Error('HTTP ' + resp.status);
            return resp.json();
          })
          .then((list) => {
            allTips = (Array.isArray(list) ? list : []).filter((tip) => tip.id !== trickId && tip.source?.kind !== 'news');
            return allTips;
          })
          .catch((err) => {
            loadPromise = null;
            throw err;
          });
      }
      return loadPromise;
    }

    function renderPagination(totalItems) {
      const totalPages = Math.max(1, Math.ceil(totalItems / ITEMS_PER_PAGE));
      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      if (pagePrevBtn) pagePrevBtn.disabled = currentPage === 1;
      if (pageNextBtn) pageNextBtn.disabled = currentPage === totalPages;

      if (pageNumbersContainer) {
        pageNumbersContainer.innerHTML = '';
        const isMobile = window.innerWidth < 640;

        if (isMobile) {
          const span = document.createElement('span');
          span.className = 'px-3 py-1 font-mono text-xs font-bold text-[var(--text-primary)]';
          span.textContent = `${currentPage} / ${totalPages}`;
          pageNumbersContainer.appendChild(span);
        } else {
          const pages = [];
          for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) {
              pages.push(i);
            } else if (pages[pages.length - 1] !== '...') {
              pages.push('...');
            }
          }

          pages.forEach((p) => {
            if (p === '...') {
              const dots = document.createElement('span');
              dots.className = 'px-1.5 py-1 text-[var(--text-muted)]';
              dots.textContent = '…';
              pageNumbersContainer.appendChild(dots);
            } else {
              const btn = document.createElement('button');
              btn.type = 'button';
              const isActive = p === currentPage;
              btn.className = `w-7 h-7 rounded-lg text-xs font-mono font-bold transition-all ${
                isActive
                  ? 'bg-[var(--accent-hero)] text-black shadow-sm'
                  : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)]'
              }`;
              btn.textContent = String(p);
              btn.addEventListener('click', () => {
                currentPage = p;
                updateView({ scroll: true });
              });
              pageNumbersContainer.appendChild(btn);
            }
          });
        }
      }

      if (paginationSubtext) {
        paginationSubtext.textContent = `page ${currentPage} / ${totalPages} · ${ITEMS_PER_PAGE} tips per page`;
      }
    }

    async function updateView(options) {
      const token = ++renderToken;
      if (!window.TipCardRenderer) {
        console.error('TipCardRenderer is missing; cannot render the list.');
        return;
      }
      let list;
      try {
        list = await ensureTips();
      } catch (err) {
        console.error('Could not load tips:', err);
        if (paginationSubtext) paginationSubtext.textContent = 'Could not load the tip list. Please try again.';
        return;
      }
      if (token !== renderToken) return;

      clientMode = true;
      if (staticPagination) staticPagination.classList.add('hidden');

      const filtered = list.filter(matches).sort(currentSort === 'newest' ? compareNewest : compareFeed);
      lastTotal = filtered.length;

      const totalPages = Math.max(1, Math.ceil(filtered.length / ITEMS_PER_PAGE));
      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      if (!filtered.length) {
        if (stream) stream.replaceChildren();
        if (emptyMsg) emptyMsg.classList.remove('hidden');
        if (dynamicPagination) dynamicPagination.classList.add('hidden');
        renderPagination(0);
        return;
      }

      if (emptyMsg) emptyMsg.classList.add('hidden');
      if (dynamicPagination) dynamicPagination.classList.remove('hidden');

      const start = (currentPage - 1) * ITEMS_PER_PAGE;
      const pageItems = filtered.slice(start, start + ITEMS_PER_PAGE);
      const frag = document.createDocumentFragment();
      pageItems.forEach((tip) => {
        if (window.TipCardRenderer) frag.appendChild(window.TipCardRenderer.create(tip, LANG, LABELS));
      });
      if (stream) stream.replaceChildren(frag);

      renderPagination(filtered.length);
      if (options && options.scroll) window.scrollTo({ top: 300, behavior: 'smooth' });
    }

    pagePrevBtn?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        updateView({ scroll: true });
      }
    });

    pageNextBtn?.addEventListener('click', () => {
      currentPage++;
      updateView({ scroll: true });
    });

    mobileSearchInput?.addEventListener('input', (e) => {
      searchQuery = e.target.value;
      currentPage = 1;
      updateView();
    });

    sourceFilter?.addEventListener('change', (e) => { currentSource = e.target.value; currentPage = 1; updateView(); });
    typeFilter?.addEventListener('change', (e) => { currentType = e.target.value; currentPage = 1; updateView(); });
    platformFilter?.addEventListener('change', (e) => { currentCat = e.target.value; currentPage = 1; updateView(); });
    languageFilter?.addEventListener('change', (e) => { currentLangFilter = e.target.value; currentPage = 1; updateView(); });

    mobileCatBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        mobileCatBtns.forEach((b) => { b.className = CAT_MOBILE_BASE; });
        btn.className = CAT_MOBILE_ACTIVE;
        currentCat = btn.getAttribute('data-category');
        currentPage = 1;
        updateView();
      });
    });

    desktopCatBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        desktopCatBtns.forEach((b) => { b.className = CAT_DESKTOP_BASE; });
        btn.className = CAT_DESKTOP_ACTIVE;
        currentCat = btn.getAttribute('data-category');
        currentPage = 1;
        updateView();
      });
    });

    diffBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        diffBtns.forEach((b) => { b.className = DIFF_BASE; });
        btn.className = DIFF_ACTIVE;
        currentDiff = btn.getAttribute('data-diff');
        currentPage = 1;
        updateView();
      });
    });

    sortBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        sortBtns.forEach((b) => { b.className = SORT_BASE; });
        btn.className = SORT_ACTIVE;
        currentSort = btn.getAttribute('data-sort');
        currentPage = 1;
        updateView();
      });
    });

    langBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        langBtns.forEach((b) => { b.className = LANG_BASE; });
        btn.className = LANG_ACTIVE;
        currentLangFilter = btn.getAttribute('data-lang-filter') || 'all';
        currentPage = 1;
        updateView();
      });
    });

    resetBtn?.addEventListener('click', () => {
      currentCat = 'all';
      currentDiff = 'all';
      currentLangFilter = 'all';
      currentSource = 'all';
      currentType = 'all';
      currentSort = 'newest';
      searchQuery = '';
      currentPage = 1;

      if (mobileSearchInput) mobileSearchInput.value = '';
      if (sourceFilter) sourceFilter.value = 'all';
      if (typeFilter) typeFilter.value = 'all';
      if (platformFilter) platformFilter.value = 'all';
      if (languageFilter) languageFilter.value = 'all';

      mobileCatBtns.forEach((b, i) => { b.className = i === 0 ? CAT_MOBILE_ACTIVE : CAT_MOBILE_BASE; });
      desktopCatBtns.forEach((b, i) => { b.className = i === 0 ? CAT_DESKTOP_ACTIVE : CAT_DESKTOP_BASE; });
      diffBtns.forEach((b, i) => { b.className = i === 0 ? DIFF_ACTIVE : DIFF_BASE; });
      langBtns.forEach((b, i) => { b.className = i === 0 ? LANG_ACTIVE : LANG_BASE; });
      sortBtns.forEach((b) => { b.className = b.getAttribute('data-sort') === 'newest' ? SORT_ACTIVE : SORT_BASE; });

      updateView();
    });

    window.addEventListener('resize', () => {
      if (!clientMode) return;
      renderPagination(lastTotal);
    });

    // The first page is pre-rendered on the server. Client mode only kicks in
    // once the visitor filters, sorts, searches, or changes page.
  })();
</script>
