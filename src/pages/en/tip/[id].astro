---
import TipDetailPage from '../../../components/pages/TipDetailPage.astro';
import { getAllTips, type Tip } from '../../../lib/data';

export async function getStaticPaths() {
  const tips = getAllTips();
  const paths: Array<{ params: { id: string }; props: { tip: Tip; isCanonical: boolean } }> = [];
  for (const tip of tips) {
    const slug = tip.slug || tip.id;
    paths.push({
      params: { id: slug },
      props: { tip, isCanonical: true },
    });
    if (slug !== tip.id) {
      paths.push({
        params: { id: tip.id },
        props: { tip, isCanonical: false },
      });
    }
  }
  return paths;
}

interface Props {
  tip: Tip;
  isCanonical: boolean;
}

const { tip, isCanonical } = Astro.props;
---

<TipDetailPage lang="en" tip={tip} isCanonical={isCanonical} />
