---
import Layout from '../../../layouts/Layout.astro';
import { getAllCategories, getAllTips, type Tip } from '../../../lib/data';
import { getTranslations } from '../../../lib/i18n';
import { SITE_URL } from '../../../lib/constants';

export async function getStaticPaths() {
  const tips = getAllTips();
  const paths: any[] = [];
  for (const tip of tips) {
    const slug = tip.slug || tip.id;
    // Canonical URL uses the slug
    paths.push({
      params: { id: slug },
      props: { tip, isCanonical: true },
    });
    // Keep legacy id URLs working via lightweight redirect to canonical slug
    if (slug !== tip.id) {
      paths.push({
        params: { id: tip.id },
        props: { tip, isCanonical: false },
      });
    }
  }
  return paths;
}

interface Props {
  tip: Tip;
  isCanonical: boolean;
}

const { tip, isCanonical } = Astro.props;
const lang = 'en';
const t = getTranslations(lang);

const titleText = tip.title[lang] || tip.title['en'] || Object.values(tip.title)[0] || '';
const origTitle = tip.title[tip.original_lang] || tip.title['en'] || titleText;

const summaryText = tip.summary[lang] || tip.summary['en'] || Object.values(tip.summary)[0] || '';
const origSummary = tip.summary[tip.original_lang] || tip.summary['en'] || summaryText;

const tipSlugOrId = tip.slug || tip.id;
const canonicalRelativePath = `/${lang}/tip/${encodeURIComponent(tipSlugOrId)}`;
const pageCanonicalUrl = `${SITE_URL}${canonicalRelativePath}`;

const validCategoryIds = new Set(getAllCategories().map((c) => c.id));
const tipCategories = Array.isArray(tip.categories) ? tip.categories : [];
const tipTags = Array.isArray(tip.tags) ? tip.tags : [];

const relatedTips = isCanonical
  ? getAllTips()
      .filter((tItem) => tItem.id !== tip.id && tItem.categories.some((c) => tipCategories.includes(c)))
      .slice(0, 3)
  : [];

const rawKeyPoints =
  Array.isArray(tip.key_points?.[lang]) && tip.key_points[lang].length > 0
    ? tip.key_points[lang]
    : Array.isArray(tip.key_points?.en) && tip.key_points.en.length > 0
      ? tip.key_points.en
      : [];
const keyPoints = rawKeyPoints
  .filter((item): item is string => typeof item === 'string' && item.trim().length > 0)
  .map((item) => item.trim());

const rawOrigKeyPoints =
  Array.isArray(tip.key_points?.[tip.original_lang]) && tip.key_points[tip.original_lang].length > 0
    ? tip.key_points[tip.original_lang]
    : Array.isArray(tip.key_points?.en) && tip.key_points.en.length > 0
      ? tip.key_points.en
      : keyPoints;
const origKeyPoints = rawOrigKeyPoints
  .filter((item): item is string => typeof item === 'string' && item.trim().length > 0)
  .map((item) => item.trim());

const isMachineTranslated = tip.translated && tip.translated[lang] === 'machine';
const isUntranslated = tip.original_lang !== lang && !isMachineTranslated;

// Format date
let formattedDate = '';
try {
  const d = new Date(tip.published_at);
  if (!isNaN(d.getTime())) {
    const day = String(d.getDate()).padStart(2, '0');
    const month = String(d.getMonth() + 1).padStart(2, '0');
    const year = d.getFullYear();
    formattedDate = `${day}/${month}/${year}`;
  }
} catch {
  formattedDate = '';
}

const primaryCat = tipCategories[0] || 'tips';
const isPrimaryCatValid = validCategoryIds.has(primaryCat);
const communitySourceLabel =
  tip.source_type === 'community-facebook'
    ? 'Facebook'
    : tip.source_type === 'community-telegram'
      ? 'Telegram'
      : tip.source_type === 'community-web'
        ? 'Web'
        : '';

const brokenLinkParams = new URLSearchParams({
  title: `[Broken Link] ${titleText}`,
  body: [
    '## Broken Link Report',
    '',
    `- **Title:** ${titleText}`,
    `- **Slug / ID:** ${tipSlugOrId} (${tip.id})`,
    `- **Original URL:** ${tip.url}`,
    `- **Tech Tips Hub page:** ${pageCanonicalUrl}`,
    '',
    '**Additional details (optional):**',
  ].join('\n'),
});
const reportBrokenLinkUrl = `https://github.com/nhattranhuynhthien/tech-tips-hub/issues/new?${brokenLinkParams.toString()}`;
---

{isCanonical ? (
  <Layout lang={lang} title={titleText} description={summaryText} canonicalPath={canonicalRelativePath} noindex={false}>
    <div class="max-w-6xl mx-auto">
      <!-- Breadcrumb with Back Arrow (Matching Mockup Page 6: ← tips / [category] /) -->
      <nav class="mb-6 flex items-center gap-2 text-xs font-mono text-[var(--text-muted)]" aria-label="Breadcrumb">
        <a href={`/${lang}`} class="hover:text-[var(--text-primary)] transition-colors flex items-center gap-1">
          <span>←</span>
          <span>tips</span>
        </a>
        <span>/</span>
        {isPrimaryCatValid ? (
          <a
            href={`/${lang}/category/${encodeURIComponent(primaryCat)}`}
            class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors lowercase"
          >
            {primaryCat}
          </a>
        ) : (
          <span class="text-[var(--text-secondary)] lowercase">{primaryCat}</span>
        )}
        <span>/</span>
      </nav>

      <!-- Main Content & Sidebar Layout (Matching Mockup Page 6) -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12 items-start">
        <!-- Left 2 Cols: Main Tip Content -->
        <article class="lg:col-span-2 space-y-6">
          <!-- Meta Row: source · author · date -->
          <div class="text-xs font-mono text-[var(--text-muted)] lowercase flex items-center gap-2 flex-wrap">
            <span class="text-[var(--text-secondary)] font-medium">{tip.source.name}</span>
            {communitySourceLabel && <span class="rounded border border-[var(--accent)]/30 px-1.5 py-0.5 text-[10px] text-[var(--accent)]">Community contribution · {communitySourceLabel}</span>}
            {tip.alsoFrom?.map((source) => <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-[var(--accent)] hover:underline">{source.sourceName}</a>)}
            {tip.author && (
              <>
                <span>·</span>
                <span>{tip.author}</span>
              </>
            )}
            {formattedDate && (
              <>
                <span>·</span>
                <span>{formattedDate}</span>
              </>
            )}
          </div>

          <!-- Huge Headline -->
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[var(--text-primary)] tracking-tight leading-snug" id="tip-headline">
            {titleText}
          </h1>

          <!-- Tags & Difficulty -->
          <div class="flex items-center gap-2 flex-wrap text-xs font-mono">
            {tipCategories.map((cat) =>
              validCategoryIds.has(cat) ? (
                <a
                  href={`/${lang}/category/${encodeURIComponent(cat)}`}
                  class="px-2 py-0.5 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--accent)] hover:border-[var(--accent-border)] hover:bg-[var(--accent-bg)] transition-colors"
                >
                  #{cat}
                </a>
              ) : (
                <a
                  href={`/${lang}?q=${encodeURIComponent(cat)}`}
                  class="px-2 py-0.5 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--accent)] hover:border-[var(--accent-border)] hover:bg-[var(--accent-bg)] transition-colors"
                >
                  #{cat}
                </a>
              )
            )}
            {tipTags.map((tag) => (
              <a
                href={`/${lang}?q=${encodeURIComponent(tag)}`}
                class="px-2 py-0.5 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--accent)] hover:border-[var(--accent-border)] hover:bg-[var(--accent-bg)] transition-colors"
              >
                #{tag}
              </a>
            ))}
            {tip.difficulty && (
              <span class="text-[var(--text-secondary)] font-semibold ml-1">
                Difficulty: {t.difficulty[tip.difficulty]}
              </span>
            )}
          </div>

          <!-- Bilingual Tabs Toggle -->
          {tip.original_lang !== 'en' && (
            <div class="inline-flex p-0.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] text-xs font-mono" id="bilingual-tabs">
              <button
                id="tab-en"
                type="button"
                class="px-3 py-1.5 rounded-lg transition-all bg-[var(--accent-hero)] text-black font-bold shadow-sm"
              >
                English {isMachineTranslated ? '(auto-translated)' : isUntranslated ? '(not translated)' : ''}
              </button>
              <button
                id="tab-orig"
                type="button"
                class="px-3 py-1.5 rounded-lg transition-all text-[var(--text-muted)] hover:text-[var(--text-primary)]"
              >
                {tip.original_lang?.startsWith('zh') ? 'Original (Chinese)' : 'Original (Vietnamese)'}
              </button>
            </div>
          )}

          <!-- Key Takeaways Callout (Only rendered when key_points exist) -->
          {keyPoints.length > 0 && (
            <section
              class="rounded-xl border border-[var(--accent-border)] bg-[var(--accent-bg)] p-5"
              aria-label="Key Takeaways"
            >
              <h2 class="text-[11px] font-mono font-bold tracking-wider text-[var(--accent)] uppercase mb-3 flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <span>Key Takeaways</span>
              </h2>
              <ul class="space-y-2 text-sm sm:text-base text-[var(--text-primary)] leading-relaxed" id="tip-key-points-list">
                {keyPoints.map((point) => (
                  <li class="flex items-start gap-2.5">
                    <span class="mt-2 w-1.5 h-1.5 rounded-full bg-[var(--accent)] shrink-0" aria-hidden="true"></span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <!-- Summary Box -->
          <div class="rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-5">
            <h2 class="text-[11px] font-mono font-bold tracking-wider text-[var(--text-muted)] uppercase mb-2">
              SUMMARY
            </h2>
            <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed" id="tip-summary-text">
              {summaryText}
            </p>
          </div>

          <!-- Big Golden Callout Box (Matching Mockup Page 6) -->
          <div class="rounded-2xl bg-[var(--accent-hero)] text-[#0e0f13] p-6 sm:p-7 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5 shadow-sm">
            <div class="space-y-1">
              <h3 class="font-bold text-lg text-[#0e0f13]">
                Full article available at original source
              </h3>
              <p class="text-xs sm:text-sm text-[#1c1d22] font-medium leading-relaxed max-w-md">
                Read directly on {tip.source.name} to support the author and view complete steps.
              </p>
            </div>

            <a
              href={tip.url}
              target="_blank"
              rel="noopener noreferrer"
              class="shrink-0 px-5 py-2.5 rounded-xl bg-black text-white hover:bg-zinc-800 transition-colors font-bold text-xs inline-flex items-center gap-1.5 shadow-sm"
            >
              <span>Read on {tip.source.name} ↗</span>
            </a>
          </div>

          <!-- Action Row -->
          <div class="flex items-center gap-2 pt-2 text-xs font-mono flex-wrap">
            <button
              type="button"
              class="bookmark-btn px-3 py-1.5 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] transition-all inline-flex items-center gap-1.5"
              data-id={tip.id}
            >
              <span data-bookmark-label>Save for later</span>
            </button>

            <button
              type="button"
              id="share-btn"
              class="px-3 py-1.5 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] transition-all"
              data-url={pageCanonicalUrl}
            >
              Share
            </button>

            <a
              href={`https://github.com/nhattranhuynhthien/tech-tips-hub/issues/new?title=Report+Issue+${tip.id}`}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] transition-all"
            >
              Report issue
            </a>

            <a
              href={reportBrokenLinkUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] hover:text-[var(--text-primary)] transition-all"
            >
              Report broken link
            </a>
          </div>
        </article>

        <!-- Right 1 Col: Sidebar -->
        <aside class="space-y-6">
          <!-- Box 1: RELATED TIPS -->
          <div class="rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-5">
            <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--text-muted)] mb-4">
              RELATED TIPS
            </h3>
            <ul class="space-y-4">
              {relatedTips.map((r) => (
                <li class="border-b border-[var(--border-subtle)] pb-3 last:border-b-0 last:pb-0">
                  <a
                    href={`/${lang}/tip/${r.slug || r.id}`}
                    class="text-xs sm:text-sm font-bold text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors leading-snug block mb-1"
                  >
                    {r.title[lang] || r.title['en']}
                  </a>
                  <span class="text-[11px] font-mono text-[var(--text-muted)]">
                    {r.source.name}
                  </span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Box 2: ABOUT THIS SUMMARY -->
          <div class="rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-5">
            <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--text-muted)] mb-3">
              ABOUT THIS SUMMARY
            </h3>
            <p class="text-xs font-mono text-[var(--text-secondary)] leading-relaxed">
              Tech Tips Hub only stores headlines and concise excerpts. Translations may be machine generated; please refer to the original article for canonical details.
            </p>
          </div>
        </aside>
      </div>
    </div>

    <script is:inline define:vars={{ tipId: tip.id, titleText, origTitle, summaryText, origSummary, keyPoints, origKeyPoints }}>
      (function () {
        if (window.TechTipsActions) {
          window.TechTipsActions.markRead(tipId);
        } else {
          window.addEventListener('DOMContentLoaded', () => window.TechTipsActions?.markRead(tipId));
        }
        const tabEn = document.getElementById('tab-en');
        const tabOrig = document.getElementById('tab-orig');
        const headline = document.getElementById('tip-headline');
        const summary = document.getElementById('tip-summary-text');
        const keyPointsList = document.getElementById('tip-key-points-list');
        const shareBtn = document.getElementById('share-btn');

        function renderKeyPoints(points) {
          if (!keyPointsList || !Array.isArray(points) || !points.length) return;
          const frag = document.createDocumentFragment();
          points.forEach((point) => {
            const li = document.createElement('li');
            li.className = 'flex items-start gap-2.5';
            const dot = document.createElement('span');
            dot.className = 'mt-2 w-1.5 h-1.5 rounded-full bg-[var(--accent)] shrink-0';
            dot.setAttribute('aria-hidden', 'true');
            const text = document.createElement('span');
            text.textContent = point;
            li.append(dot, text);
            frag.appendChild(li);
          });
          keyPointsList.replaceChildren(frag);
        }

        tabEn?.addEventListener('click', () => {
          tabEn.className = 'px-3 py-1.5 rounded-lg transition-all bg-[var(--accent-hero)] text-black font-bold shadow-sm';
          if (tabOrig) tabOrig.className = 'px-3 py-1.5 rounded-lg transition-all text-[var(--text-muted)] hover:text-[var(--text-primary)]';
          if (headline) headline.textContent = titleText;
          if (summary) summary.textContent = summaryText;
          renderKeyPoints(keyPoints);
        });

        tabOrig?.addEventListener('click', () => {
          tabOrig.className = 'px-3 py-1.5 rounded-lg transition-all bg-[var(--accent-hero)] text-black font-bold shadow-sm';
          if (tabEn) tabEn.className = 'px-3 py-1.5 rounded-lg transition-all text-[var(--text-muted)] hover:text-[var(--text-primary)]';
          if (headline) headline.textContent = origTitle;
          if (summary) summary.textContent = origSummary;
          renderKeyPoints(origKeyPoints);
        });

        shareBtn?.addEventListener('click', () => {
          const url = shareBtn.getAttribute('data-url') || window.location.href;
          if (navigator.clipboard) {
            navigator.clipboard.writeText(url).then(() => {
              shareBtn.textContent = 'Link copied!';
              setTimeout(() => {
                shareBtn.textContent = 'Share';
              }, 2000);
            });
          }
        });
      })();
    </script>
  </Layout>
) : (
  <html lang={lang}>
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>{titleText ? `${titleText} — tips.hub` : 'tips.hub'}</title>
      <meta name="robots" content="noindex, follow" />
      <link rel="canonical" href={pageCanonicalUrl} />
      <meta http-equiv="refresh" content={`0; url=${canonicalRelativePath}`} />
      <script is:inline define:vars={{ canonicalRelativePath }}>
        window.location.replace(canonicalRelativePath);
      </script>
    </head>
    <body style="background:#0F1114;color:#ECEAE4;font-family:system-ui,-apple-system,sans-serif;display:flex;min-height:100vh;align-items:center;justify-content:center;margin:0;padding:1.5rem;text-align:center">
      <p>
        Redirecting to{' '}
        <a href={canonicalRelativePath} style="color:#FFB547">{titleText || canonicalRelativePath}</a>…
      </p>
    </body>
  </html>
)}
