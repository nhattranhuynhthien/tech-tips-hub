---
import Layout from '../../layouts/Layout.astro';
import { getTranslations } from '../../lib/i18n';

const lang = 'en';
const t = getTranslations(lang);
---

<Layout lang={lang} title="About tips.hub" description="Learn about the mission, provider-dependent operating costs, and ethical aggregation philosophy of tips.hub.">
  <article class="max-w-4xl mx-auto space-y-8">
    <!-- Header -->
    <header class="pb-6 border-b border-[var(--border-color)]">
      <div class="text-xs font-mono font-bold text-[var(--accent)] mb-2">
        $ info tips.hub
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--text-primary)] tracking-tight mb-3">
        About tips.hub
      </h1>
      <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed font-mono">
        An open-source bilingual tech notebook that aggregates practical tips and clearly credits their sources. Infrastructure and translation costs depend on provider plans and usage.
      </p>
    </header>

    <div class="space-y-8 text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed font-sans">
      <!-- 1. Purpose -->
      <section class="rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-6 space-y-3">
        <h2 class="text-lg font-bold text-[var(--text-primary)] font-mono">
          # The Mission
        </h2>
        <p>
          The web is full of brilliant developer tricks scattered across disparate silos: a tactile macOS shortcut on Twitter/X, a Linux disk cleanup one-liner on Reddit, a Windows troubleshooting tweak on BleepingComputer, or an ad-blocking guide on Hacker News.
        </p>
        <p>
          <strong class="text-[var(--text-primary)]">tips.hub</strong> aggregates, curates, and summarizes practical how-to tips into an instant, searchable notebook — available in both <strong class="text-[var(--text-primary)]">English and Vietnamese</strong>, always linking back directly to original authors.
        </p>
      </section>

      <!-- 2. Core Principles -->
      <section class="rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-6 space-y-4">
        <h3 class="text-lg font-bold text-[var(--text-primary)] font-mono">
          # Core Principles
        </h3>
        <ol class="space-y-3 list-decimal list-inside text-xs sm:text-sm text-[var(--text-secondary)] font-mono">
          <li><strong class="text-[var(--text-primary)]">Low-cost infrastructure:</strong> Collection and static hosting use free tiers while within provider limits. Translation usage or provider policy changes may add costs.</li>
          <li><strong class="text-[var(--text-primary)]">Fair Use & Original Attribution:</strong> We never copy full article bodies. We store concise headlines and excerpts under 280 characters, pointing readers directly to original creators.</li>
          <li><strong class="text-[var(--text-primary)]">Respect for Creators:</strong> Complete transparency with source domain badges, author credits, robots.txt compliance, and polite request rate limiting.</li>
          <li><strong class="text-[var(--text-primary)]">Static-First Architecture:</strong> Pre-rendered static pages ensure sub-second latency, robust resilience, and zero database failure risks.</li>
          <li><strong class="text-[var(--text-primary)]">Quality Over Volume:</strong> Automated deduplication, spam/deal blocklists, and automated QA verification before any content goes live.</li>
        </ol>
      </section>

      <!-- 3. Architecture -->
      <section class="rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-6 space-y-3">
        <h2 class="text-lg font-bold text-[var(--text-primary)] font-mono">
          # Technical Architecture
        </h2>
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] font-mono mb-4">
          Fully automated pipeline driven by scheduled GitHub Actions:
        </p>
        <div class="p-4 rounded-lg bg-[var(--bg-muted)] border border-[var(--border-color)] font-mono text-xs overflow-x-auto text-[var(--text-primary)] leading-normal">
<pre>
┌────────────────────┐   cron every 4h
│  GitHub Actions    │───────────────────────┐
└────────────────────┘                       │
                                             ▼
   RSS / API  ──►  fetch.py  ──►  dedupe.py  ──►  score.py  ──►  classify.py
 (20+ sources)                                                         │
                                                                       ▼
                                            translate.py (no mixed language)
                                                                       │
                                                                       ▼
                                             scripts/qa.py (100% validation)
                                                                       │
                                                                       ▼
                                       Astro static build (Cloudflare / Vercel)
                                                                       │
                                                                       ▼
                                            Bilingual Static Site (/vi, /en)
</pre>
        </div>
      </section>
    </div>
  </article>
</Layout>
