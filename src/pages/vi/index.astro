---
import Layout from '../../layouts/Layout.astro';
import TipCard from '../../components/TipCard.astro';
import CompactTipRow from '../../components/CompactTipRow.astro';
import TrickOfTheDay from '../../components/TrickOfTheDay.astro';
import { getAllTips, getTrickOfTheDay, getCategoriesWithCounts } from '../../lib/data';
import { getTranslations } from '../../lib/i18n';

const lang = 'vi';
const t = getTranslations(lang);
const tips = getAllTips();
const trickOfDay = getTrickOfTheDay();
const categoriesWithCounts = getCategoriesWithCounts();

// Trending tags
const trendingTags = [
  'windows11', 'shortcuts', 'terminal', 'docker', 'privacy', 'battery', 'ai', 'performance'
];
---

<Layout lang={lang} title={t.site.tagline}>
  <!-- Hero Section (Phong cách Sổ tay Tạp chí Kỹ thuật - Editorial Tech Journal) -->
  <header class="mb-10 pb-8 border-b border-[var(--border-color)]">
    <!-- Masthead Rule: Issue Details -->
    <div class="flex items-center justify-between text-[11px] font-mono uppercase tracking-wider text-[var(--text-muted)] border-b border-[var(--border-subtle)] pb-2.5 mb-6 flex-wrap gap-2">
      <div class="flex items-center gap-2">
        <span class="font-bold text-[var(--accent)]">Tech Tips Hub</span>
        <span>•</span>
        <span>Ấn phẩm Sổ tay Số</span>
        <span>•</span>
        <span>Song ngữ EN / VI</span>
      </div>
      <div class="flex items-center gap-2">
        <span>Chi phí 0đ</span>
        <span>•</span>
        <span>Kho lưu trữ: {tips.length} bài viết</span>
      </div>
    </div>

    <div class="max-w-3xl">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-bold tracking-tight text-[var(--text-primary)] mb-4 leading-tight">
        Sổ tay thủ thuật của dân công nghệ.
      </h1>

      <p class="text-base sm:text-lg text-[var(--text-secondary)] leading-relaxed mb-6">
        Tuyển tập mẹo hay, phím tắt thực chiến và cẩm nang xử lý sự cố cho Windows, macOS, Linux, Android, iOS và công cụ phát triển. Luôn ghi nguồn tác giả gốc, tinh gọn và hoàn toàn miễn phí.
      </p>

      <!-- In-Hero Fast Search Bar -->
      <div class="relative max-w-xl mb-4">
        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[var(--text-muted)]">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8" stroke-width="2"></circle>
            <path d="m21 21-4.35-4.35" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </div>
        <input
          id="hero-search-input"
          type="search"
          placeholder="Lọc nhanh: gõ từ khóa, phím tắt, Windows 11, Docker, terminal..."
          class="w-full pl-10 pr-12 py-2.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] text-sm text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:border-[var(--accent)] focus:bg-[var(--bg-primary)] shadow-sm transition-all"
        />
        <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
          <kbd class="text-[10px]">/</kbd>
        </div>
      </div>

      <!-- Trending Quick Filter Tags -->
      <div class="flex flex-wrap items-center gap-1.5 text-xs font-mono">
        <span class="text-[var(--text-muted)] font-medium">Xu hướng:</span>
        {trendingTags.map((tag) => (
          <button
            type="button"
            class="hero-tag-btn px-2 py-0.5 rounded text-[11px] border border-[var(--border-subtle)] bg-[var(--bg-muted)] text-[var(--text-secondary)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors"
            data-tag={tag}
          >
            #{tag}
          </button>
        ))}
      </div>
    </div>
  </header>

  <!-- Trick of the Day -->
  {trickOfDay && <TrickOfTheDay tip={trickOfDay} lang={lang} />}

  <!-- Main Content Controls: Filter Pills & View Mode Switcher -->
  <section class="mb-8" aria-label="Bộ lọc thủ thuật">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
      <div>
        <h2 class="text-xl font-serif font-bold text-[var(--text-primary)]">
          {t.home.latest_tips}
        </h2>
        <p class="text-xs text-[var(--text-muted)] font-mono mt-0.5">
          {t.home.latest_tips_sub}
        </p>
      </div>

      <!-- Right Controls: View Mode Switcher & Difficulty Filter -->
      <div class="flex items-center gap-3 text-xs flex-wrap">
        <!-- View Mode Switcher (Grid vs Compact List) -->
        <div class="inline-flex items-center p-0.5 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)]" title="Chuyển chế độ hiển thị">
          <button
            id="view-grid-btn"
            type="button"
            class="view-mode-btn p-1.5 rounded-md border border-[var(--accent)] bg-[var(--accent)] text-white shadow-sm transition-all"
            aria-label="Chế độ lưới thẻ (Grid view)"
            title="Chế độ lưới thẻ (Grid view)"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <rect width="7" height="7" x="3" y="3" rx="1"></rect>
              <rect width="7" height="7" x="14" y="3" rx="1"></rect>
              <rect width="7" height="7" x="14" y="14" rx="1"></rect>
              <rect width="7" height="7" x="3" y="14" rx="1"></rect>
            </svg>
          </button>
          <button
            id="view-compact-btn"
            type="button"
            class="view-mode-btn p-1.5 rounded-md border border-transparent bg-transparent text-[var(--text-secondary)] hover:text-[var(--accent)] transition-all"
            aria-label="Chế độ danh sách gọn (Compact list)"
            title="Chế độ danh sách gọn (Compact list)"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <line x1="3" y1="6" x2="21" y2="6" stroke-width="2" stroke-linecap="round"></line>
              <line x1="3" y1="12" x2="21" y2="12" stroke-width="2" stroke-linecap="round"></line>
              <line x1="3" y1="18" x2="21" y2="18" stroke-width="2" stroke-linecap="round"></line>
            </svg>
          </button>
        </div>

        <!-- Difficulty Filter -->
        <div class="inline-flex p-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)]" id="difficulty-filter-group">
          <button
            type="button"
            class="diff-btn px-2.5 py-1 rounded text-xs font-mono font-medium transition-colors bg-[var(--accent)] text-white"
            data-diff="all"
          >
            {t.home.all_difficulties}
          </button>
          <button
            type="button"
            class="diff-btn px-2.5 py-1 rounded text-xs font-mono font-medium transition-colors text-[var(--text-secondary)] hover:text-[var(--accent)]"
            data-diff="easy"
          >
            {t.difficulty.easy}
          </button>
          <button
            type="button"
            class="diff-btn px-2.5 py-1 rounded text-xs font-mono font-medium transition-colors text-[var(--text-secondary)] hover:text-[var(--accent)]"
            data-diff="medium"
          >
            {t.difficulty.medium}
          </button>
          <button
            type="button"
            class="diff-btn px-2.5 py-1 rounded text-xs font-mono font-medium transition-colors text-[var(--text-secondary)] hover:text-[var(--accent)]"
            data-diff="advanced"
          >
            {t.difficulty.advanced}
          </button>
        </div>
      </div>
    </div>

    <!-- Category Filter Pills -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none" id="category-filter-group">
      <button
        type="button"
        class="cat-btn shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold font-mono border transition-all border-[var(--accent)] bg-[var(--accent)] text-white shadow-sm"
        data-category="all"
      >
        Tất cả ({tips.length})
      </button>
      {categoriesWithCounts.map((cat) => (
        <button
          type="button"
          class="cat-btn shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold font-mono border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-all"
          data-category={cat.id}
        >
          {cat.name.vi} ({cat.count})
        </button>
      ))}
    </div>
  </section>

  <!-- Mode 1: Tips Grid (Card View) -->
  <div id="tips-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {tips.map((tip) => (
      <TipCard tip={tip} lang={lang} />
    ))}
  </div>

  <!-- Mode 2: Tips Compact List (High density view) -->
  <div id="tips-compact-list" class="hidden space-y-2">
    {tips.map((tip, idx) => (
      <CompactTipRow tip={tip} lang={lang} index={idx} />
    ))}
  </div>

  <!-- Empty Search / Filter state -->
  <div id="empty-tips-msg" class="hidden py-16 text-center border border-dashed border-[var(--border-color)] rounded-xl bg-[var(--bg-surface)] mt-6">
    <div class="w-12 h-12 mx-auto rounded-full bg-[var(--bg-muted)] flex items-center justify-center text-[var(--text-muted)] mb-3">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="8" stroke-width="2"></circle>
        <path d="m21 21-4.35-4.35" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </div>
    <h3 class="text-base font-serif font-bold text-[var(--text-primary)] mb-1">
      {t.home.no_tips_found}
    </h3>
    <p class="text-xs text-[var(--text-muted)] mb-4">
      Hãy thử chọn danh mục khác hoặc xóa bộ lọc độ khó.
    </p>
    <button
      id="reset-filter-btn"
      type="button"
      class="px-4 py-2 rounded-lg text-xs font-semibold bg-[var(--accent)] text-white hover:bg-[var(--accent-hover)] transition-colors"
    >
      {t.home.clear_filters}
    </button>
  </div>
</Layout>

<script is:inline>
  (function () {
    let currentCat = 'all';
    let currentDiff = 'all';
    let searchQuery = '';

    const catButtons = document.querySelectorAll('.cat-btn');
    const diffButtons = document.querySelectorAll('.diff-btn');
    const heroTags = document.querySelectorAll('.hero-tag-btn');
    const heroInput = document.getElementById('hero-search-input');
    const cards = document.querySelectorAll('.tip-card');
    const compactRows = document.querySelectorAll('.compact-tip-row');
    const emptyMsg = document.getElementById('empty-tips-msg');
    const resetBtn = document.getElementById('reset-filter-btn');

    function applyFilter() {
      let visibleCount = 0;
      const q = searchQuery.toLowerCase().trim();

      const filterItem = (el) => {
        const cats = el.getAttribute('data-category') || '';
        const diff = el.getAttribute('data-difficulty') || '';
        const text = el.textContent ? el.textContent.toLowerCase() : '';

        const matchCat = currentCat === 'all' || cats.split(' ').includes(currentCat);
        const matchDiff = currentDiff === 'all' || diff === currentDiff;
        const matchSearch = !q || text.includes(q);

        if (matchCat && matchDiff && matchSearch) {
          el.classList.remove('hidden');
          return true;
        } else {
          el.classList.add('hidden');
          return false;
        }
      };

      cards.forEach((c) => {
        if (filterItem(c)) visibleCount++;
      });
      compactRows.forEach((r) => {
        filterItem(r);
      });

      if (emptyMsg) {
        if (visibleCount === 0) {
          emptyMsg.classList.remove('hidden');
        } else {
          emptyMsg.classList.add('hidden');
        }
      }
    }

    // Hero search input listener
    heroInput?.addEventListener('input', (e) => {
      searchQuery = e.target.value;
      applyFilter();
    });

    // Trending Tag pills
    heroTags.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-tag');
        if (heroInput) heroInput.value = tag;
        searchQuery = tag;
        applyFilter();
      });
    });

    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        catButtons.forEach((b) => {
          b.className = 'cat-btn shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold font-mono border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-all';
        });
        btn.className = 'cat-btn shrink-0 px-3 py-1.5 rounded-lg text-xs font-semibold font-mono border transition-all border-[var(--accent)] bg-[var(--accent)] text-white shadow-sm';
        currentCat = btn.getAttribute('data-category');
        applyFilter();
      });
    });

    diffButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        diffButtons.forEach((b) => {
          b.className = 'diff-btn px-2.5 py-1 rounded text-xs font-mono font-medium transition-colors text-[var(--text-secondary)] hover:text-[var(--accent)]';
        });
        btn.className = 'diff-btn px-2.5 py-1 rounded text-xs font-mono font-medium transition-colors bg-[var(--accent)] text-white';
        currentDiff = btn.getAttribute('data-diff');
        applyFilter();
      });
    });

    resetBtn?.addEventListener('click', () => {
      currentCat = 'all';
      currentDiff = 'all';
      searchQuery = '';
      if (heroInput) heroInput.value = '';
      catButtons[0]?.click();
      diffButtons[0]?.click();
    });
  })();
</script>
