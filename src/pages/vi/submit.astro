---
import Layout from '../../layouts/Layout.astro';
import { getTranslations } from '../../lib/i18n';
const lang = 'vi';
const t = getTranslations(lang);
const issueUrl = 'https://github.com/nhattranhuynhthien/tech-tips-hub/issues/new?template=community-tip.yml';
---

<Layout lang={lang} title="Gửi mẹo công nghệ" description="Đóng góp một mẹo công nghệ ngắn có nguồn để quản trị viên xem xét.">
  <article class="max-w-3xl mx-auto space-y-5">
    <p class="text-xs font-mono font-bold text-[var(--accent)]">$ community/inbox</p>
    <h1 class="text-3xl font-extrabold text-[var(--text-primary)]">Gửi mẹo công nghệ</h1>
    <p class="text-sm leading-relaxed text-[var(--text-secondary)]">Gửi tiêu đề, phần hướng dẫn ngắn và link nguồn gốc nếu có. Quản trị viên sẽ duyệt thủ công; nội dung chưa được duyệt sẽ không xuất hiện trên trang.</p>
    <p class="text-sm leading-relaxed text-[var(--text-secondary)]">Vui lòng không gửi toàn văn bài viết. Tên hiển thị là tùy chọn; nếu điền tên, bạn có thể chọn đồng ý ghi công trong biểu mẫu.</p>
    <a href={issueUrl} target="_blank" rel="noopener noreferrer" class="inline-flex rounded-xl bg-[var(--accent-hero)] px-4 py-2 text-sm font-bold text-black">Mở biểu mẫu đóng góp trên GitHub ↗</a>
  </article>
</Layout>
