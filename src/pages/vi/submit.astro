---
import Layout from '../../layouts/Layout.astro';
import { getTranslations } from '../../lib/i18n';
const lang = 'vi';
const t = getTranslations(lang);
const botUsername = (import.meta.env.PUBLIC_TELEGRAM_BOT_USERNAME || '').replace(/^@/, '');
const botUrl = botUsername ? `https://t.me/${botUsername}` : '';
const issueUrl = 'https://github.com/nhattranhuynhthien/tech-tips-hub/issues/new?template=community-tip.yml';
---

<Layout lang={lang} title="Gửi mẹo công nghệ" description="Đóng góp một mẹo công nghệ ngắn có nguồn để quản trị viên xem xét.">
  <article class="max-w-3xl mx-auto space-y-5">
    <p class="text-xs font-mono font-bold text-[var(--accent)]">$ community/inbox</p>
    <h1 class="text-3xl font-extrabold text-[var(--text-primary)]">Gửi mẹo công nghệ</h1>
    <p class="text-sm leading-relaxed text-[var(--text-secondary)]">Gửi link mẹo từ Telegram, Facebook hoặc web kèm ghi chú do bạn tự viết. Bạn cũng có thể forward bài từ một kênh Telegram công khai. Quản trị viên duyệt thủ công trước khi bài xuất hiện trên trang.</p>
    <p class="text-sm leading-relaxed text-[var(--text-secondary)]">Không gửi toàn văn bài viết. Với Facebook, bot chỉ lưu link và mô tả bạn cung cấp, không tải nội dung trang. Tên người gửi không hiển thị trên site.</p>
    {botUrl && <a href={botUrl} target="_blank" rel="noopener noreferrer" class="inline-flex rounded-xl bg-[var(--accent-hero)] px-4 py-2 text-sm font-bold text-black">Mở Telegram bot ↗</a>}
    <a href={issueUrl} target="_blank" rel="noopener noreferrer" class="inline-flex rounded-xl border border-[var(--border-color)] px-4 py-2 text-sm font-bold text-[var(--text-primary)]">Gửi qua GitHub ↗</a>
  </article>
</Layout>
