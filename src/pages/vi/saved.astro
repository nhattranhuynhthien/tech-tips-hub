---
import Layout from '../../layouts/Layout.astro';
import { getTranslations } from '../../lib/i18n';

const lang = 'vi';
const t = getTranslations(lang);
---

<Layout lang={lang} title="Thủ thuật đã lưu" description="Các mẹo và thủ thuật công nghệ bạn đã đánh dấu để xem lại.">
  <div class="max-w-4xl mx-auto">
    <!-- Header with Command Prompt & Export/Import Controls -->
    <header class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <div class="text-xs font-mono font-bold text-[var(--accent)] mb-2">
          $ ls đã-lưu/
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--text-primary)] tracking-tight mb-2">
          Thủ thuật đã lưu
        </h1>
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] font-mono leading-relaxed max-w-xl" id="saved-counter">
          Đang tải danh sách đã lưu từ trình duyệt của bạn...
        </p>
      </div>

      <!-- Export / Import JSON Bookmarks -->
      <div class="flex items-center gap-2 shrink-0 text-xs font-mono">
        <button
          id="export-bookmarks-btn"
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] hover:text-[var(--text-primary)] transition-all"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            <polyline points="7 10 12 15 17 10" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polyline>
            <line x1="12" y1="15" x2="12" y2="3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></line>
          </svg>
          <span>Xuất JSON</span>
        </button>

        <button
          id="import-bookmarks-btn"
          type="button"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:border-[var(--accent-border)] hover:text-[var(--accent)] transition-all"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            <polyline points="17 8 12 3 7 8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polyline>
            <line x1="12" y1="3" x2="12" y2="15" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></line>
          </svg>
          <span>Nhập JSON</span>
        </button>

        <input
          id="import-bookmarks-input"
          type="file"
          accept="application/json,.json"
          class="hidden"
          aria-label="Nhập danh sách thủ thuật từ tệp JSON"
        />
      </div>
    </header>

    <!-- Empty State -->
    <div id="saved-empty-state" class="hidden py-16 text-center border border-dashed border-[var(--border-color)] rounded-xl bg-[var(--bg-surface)]">
      <div class="w-12 h-12 mx-auto rounded-full bg-[var(--bg-muted)] flex items-center justify-center text-[var(--text-muted)] mb-3">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
      <h3 class="text-base font-bold text-[var(--text-primary)] mb-2 font-mono">
        Chưa có thủ thuật nào được lưu
      </h3>
      <p class="text-xs text-[var(--text-muted)] font-mono mb-4">
        Hãy bấm biểu tượng lưu ở các bài viết để đọc lại bất kỳ lúc nào.
      </p>
      <a
        href={`/${lang}`}
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-mono font-bold bg-[var(--accent-hero)] text-black shadow-sm"
      >
        <span>Khám phá ngay</span>
      </a>
    </div>

    <!-- Cards are rendered client-side from localStorage + /api/all-vi.json (fallback /api/tips.json) -->
    <div id="saved-stream" class="space-y-4"></div>
  </div>
</Layout>

<script is:inline define:vars={{ lang }}>
  (function () {
    const SAVED_KEY = 'techtips_saved';
    const READ_KEY = 'techtips_read';
    const MAX_READ_ITEMS = 500;
    const MAX_IMPORT_BYTES = 5 * 1024 * 1024;

    const stream = document.getElementById('saved-stream');
    const emptyState = document.getElementById('saved-empty-state');
    const counter = document.getElementById('saved-counter');
    const exportBtn = document.getElementById('export-bookmarks-btn');
    const importBtn = document.getElementById('import-bookmarks-btn');
    const importInput = document.getElementById('import-bookmarks-input');
    let tipsById = null;

    function notify(message, variant) {
      if (window.TechTipsActions && typeof window.TechTipsActions.showToast === 'function') {
        window.TechTipsActions.showToast(message, variant);
      }
    }

    function sanitizeIdList(raw) {
      if (!Array.isArray(raw)) return [];
      const seen = new Set();
      const result = [];
      for (const item of raw) {
        if (typeof item !== 'string') continue;
        const trimmed = item.trim();
        if (!trimmed || trimmed.length > 128 || seen.has(trimmed)) continue;
        seen.add(trimmed);
        result.push(trimmed);
      }
      return result;
    }

    function getStoredIds(key) {
      try {
        const parsed = JSON.parse(localStorage.getItem(key));
        return sanitizeIdList(parsed);
      } catch {
        return [];
      }
    }

    function setStoredIds(key, ids) {
      localStorage.setItem(key, JSON.stringify(ids));
    }

    async function loadTips() {
      if (tipsById) return tipsById;
      let resp = null;
      try {
        resp = await fetch(`/api/all-${lang}.json`);
      } catch {
        resp = null;
      }
      if (!resp || !resp.ok) {
        resp = await fetch('/api/tips.json');
      }
      if (!resp.ok) throw new Error('Cannot load tips');
      const list = await resp.json();
      if (!Array.isArray(list)) throw new Error('Invalid tips payload');
      tipsById = new Map(list.map((tip) => [tip.id, tip]));
      return tipsById;
    }

    function createCard(tip) {
      const article = document.createElement('article');
      article.className = 'bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--border-strong)] rounded-xl p-5 transition-all flex flex-col gap-3';
      article.setAttribute('data-tip-id', tip.id);

      const meta = document.createElement('div');
      meta.className = 'flex items-center gap-2 text-xs font-mono text-[var(--text-muted)] flex-wrap';

      const source = document.createElement('span');
      source.className = 'text-[var(--text-secondary)] font-medium lowercase';
      source.textContent = tip.source?.name || '';

      const dot = document.createElement('span');
      dot.textContent = '·';

      const category = document.createElement('span');
      category.className = 'lowercase text-[var(--accent)]';
      category.textContent = (tip.categories || [])[0] || 'tips';

      meta.append(source, dot, category);

      const heading = document.createElement('h2');
      heading.className = 'text-base sm:text-lg font-bold leading-snug text-[var(--text-primary)]';

      const link = document.createElement('a');
      link.href = `/${lang}/tip/${encodeURIComponent(tip.slug || tip.id)}`;
      link.className = 'hover:text-[var(--accent)] transition-colors';
      link.textContent = tip.title?.[lang] || tip.title?.en || Object.values(tip.title || {})[0] || '';
      heading.appendChild(link);

      const summary = document.createElement('p');
      summary.className = 'text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed line-clamp-2';
      summary.textContent = tip.summary?.[lang] || tip.summary?.en || Object.values(tip.summary || {})[0] || '';

      const footer = document.createElement('div');
      footer.className = 'pt-3 border-t border-[var(--border-subtle)] flex items-center justify-between gap-2 text-xs font-mono';

      const detail = document.createElement('a');
      detail.href = link.href;
      detail.className = 'text-[var(--accent)] hover:underline font-semibold';
      detail.textContent = 'Xem chi tiết →';

      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'bookmark-btn px-2.5 py-1 rounded-lg border border-[var(--accent)] text-[var(--accent)] hover:bg-[var(--bg-muted)] transition-colors';
      remove.setAttribute('data-id', tip.id);
      remove.setAttribute('aria-pressed', 'true');
      remove.textContent = 'Bỏ lưu';

      footer.append(detail, remove);
      article.append(meta, heading, summary, footer);
      return article;
    }

    async function renderSaved() {
      if (!stream || !emptyState || !counter) return;

      const saved = getStoredIds(SAVED_KEY);
      stream.replaceChildren();
      emptyState.classList.add('hidden');

      if (!saved.length) {
        counter.textContent = 'Bạn chưa lưu thủ thuật nào trong trình duyệt này.';
        emptyState.classList.remove('hidden');
        return;
      }

      try {
        const map = await loadTips();
        const items = saved.map((id) => map.get(id)).filter(Boolean);
        items.forEach((tip) => stream.appendChild(createCard(tip)));

        counter.textContent = `Bạn đang lưu ${items.length} thủ thuật cục bộ trong trình duyệt.`;
        if (!items.length) emptyState.classList.remove('hidden');
      } catch {
        counter.textContent = 'Không tải được danh sách thủ thuật. Vui lòng thử lại.';
      }
    }

    function exportBookmarks() {
      const payload = {
        version: 1,
        exported_at: new Date().toISOString(),
        saved: getStoredIds(SAVED_KEY),
        read: getStoredIds(READ_KEY),
      };
      const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'techtips-bookmarks.json';
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      notify(`Đã xuất ${payload.saved.length} thủ thuật đã lưu và ${payload.read.length} đã đọc`);
    }

    async function handleImportFile(file) {
      if (!file) return;
      if (file.size > MAX_IMPORT_BYTES) {
        notify('Tệp JSON quá lớn (tối đa 5MB).', 'error');
        return;
      }

      let parsed;
      try {
        const rawText = await file.text();
        parsed = JSON.parse(rawText);
      } catch {
        notify('Tệp JSON không hợp lệ. Vui lòng kiểm tra lại định dạng.', 'error');
        return;
      }

      const isPlainObject = parsed !== null && typeof parsed === 'object' && !Array.isArray(parsed);
      const validVersion = parsed?.version === undefined || parsed.version === 1;
      const hasSaved = isPlainObject && Object.prototype.hasOwnProperty.call(parsed, 'saved');
      const hasRead = isPlainObject && Object.prototype.hasOwnProperty.call(parsed, 'read');
      const validSavedField = !hasSaved || Array.isArray(parsed.saved);
      const validReadField = !hasRead || Array.isArray(parsed.read);

      if (!isPlainObject || !validVersion || (!hasSaved && !hasRead) || !validSavedField || !validReadField) {
        notify('Cấu trúc tệp JSON không đúng định dạng Tech Tips Hub.', 'error');
        return;
      }

      const existingSaved = getStoredIds(SAVED_KEY);
      const existingRead = getStoredIds(READ_KEY);
      const incomingSaved = hasSaved ? sanitizeIdList(parsed.saved) : [];
      const incomingRead = hasRead ? sanitizeIdList(parsed.read) : [];

      const existingSavedSet = new Set(existingSaved);
      const existingReadSet = new Set(existingRead);
      const addedSaved = incomingSaved.filter((id) => !existingSavedSet.has(id)).length;
      const addedRead = incomingRead.filter((id) => !existingReadSet.has(id)).length;

      const mergedSaved = Array.from(new Set([...existingSaved, ...incomingSaved]));
      let mergedRead = Array.from(new Set([...existingRead, ...incomingRead]));
      if (mergedRead.length > MAX_READ_ITEMS) {
        mergedRead = mergedRead.slice(mergedRead.length - MAX_READ_ITEMS);
      }

      try {
        setStoredIds(SAVED_KEY, mergedSaved);
        setStoredIds(READ_KEY, mergedRead);
      } catch {
        notify('Không thể lưu vào trình duyệt. Bộ nhớ cục bộ có thể đã đầy.', 'error');
        return;
      }

      await renderSaved();
      window.TechTipsActions?.updateCardsUI?.();
      notify(`Đã nhập thành công (+${addedSaved} đã lưu, +${addedRead} đã đọc)`);
    }

    exportBtn?.addEventListener('click', exportBookmarks);
    importBtn?.addEventListener('click', () => importInput?.click());
    importInput?.addEventListener('change', async (e) => {
      const target = e.target;
      const file = target && target.files && target.files[0];
      try {
        await handleImportFile(file);
      } finally {
        if (target) target.value = '';
      }
    });

    renderSaved();
    window.addEventListener('storage', renderSaved);
    window.addEventListener('techtips:bookmark_changed', renderSaved);
  })();
</script>
