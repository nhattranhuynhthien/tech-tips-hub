---
import Layout from '../../layouts/Layout.astro';
import TipCard from '../../components/TipCard.astro';
import { getAllTips } from '../../lib/data';
import { getTranslations } from '../../lib/i18n';

const lang = 'vi';
const t = getTranslations(lang);
const allTips = getAllTips();
---

<Layout lang={lang} title="Thủ thuật đã lưu" description="Các mẹo và thủ thuật công nghệ bạn đã đánh dấu để xem lại.">
  <div class="max-w-4xl mx-auto">
    <!-- Header with Command Prompt -->
    <header class="mb-8">
      <div class="text-xs font-mono font-bold text-[var(--accent)] mb-2">
        $ ls đã-lưu/
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--text-primary)] tracking-tight mb-2">
        Thủ thuật đã lưu
      </h1>
      <p class="text-xs sm:text-sm text-[var(--text-secondary)] font-mono leading-relaxed max-w-xl" id="saved-counter">
        Đang tải danh sách đã lưu từ trình duyệt của bạn...
      </p>
    </header>

    <!-- Empty State -->
    <div id="saved-empty-state" class="hidden py-16 text-center border border-dashed border-[var(--border-color)] rounded-xl bg-[var(--bg-surface)]">
      <div class="w-12 h-12 mx-auto rounded-full bg-[var(--bg-muted)] flex items-center justify-center text-[var(--text-muted)] mb-3">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
      <h3 class="text-base font-bold text-[var(--text-primary)] mb-2 font-mono">
        Chưa có thủ thuật nào được lưu
      </h3>
      <p class="text-xs text-[var(--text-muted)] font-mono mb-4">
        Hãy bấm biểu tượng lưu ở các bài viết để đọc lại bất kỳ lúc nào.
      </p>
      <a
        href={`/${lang}`}
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-mono font-bold bg-[var(--accent-hero)] text-black shadow-sm"
      >
        <span>Khám phá ngay</span>
      </a>
    </div>

    <!-- Cards Stream Container -->
    <div id="saved-stream" class="space-y-4">
      {allTips.map((tip) => (
        <div class="saved-item-wrapper hidden" data-id={tip.id}>
          <TipCard tip={tip} lang={lang} />
        </div>
      ))}
    </div>
  </div>
</Layout>

<script is:inline>
  (function () {
    const SAVED_KEY = 'techtips_saved';
    const wrappers = document.querySelectorAll('.saved-item-wrapper');
    const emptyState = document.getElementById('saved-empty-state');
    const counter = document.getElementById('saved-counter');

    function renderSaved() {
      let saved = [];
      try {
        saved = JSON.parse(localStorage.getItem(SAVED_KEY)) || [];
      } catch {}

      let visible = 0;
      wrappers.forEach((el) => {
        const id = el.getAttribute('data-id');
        if (saved.includes(id)) {
          el.classList.remove('hidden');
          visible++;
        } else {
          el.classList.add('hidden');
        }
      });

      if (counter) {
        counter.textContent = `Bạn đang lưu trữ ${visible} thủ thuật cục bộ trong trình duyệt.`;
      }

      if (emptyState) {
        if (visible === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    }

    renderSaved();
    window.addEventListener('storage', renderSaved);
  })();
</script>
