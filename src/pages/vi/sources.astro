---
import Layout from '../../layouts/Layout.astro';
import { getAllSources, getAllTips } from '../../lib/data';
import { getTranslations } from '../../lib/i18n';

const lang = 'vi';
const t = getTranslations(lang);
const sources = getAllSources();
const tips = getAllTips();

// Đếm số bài viết từ mỗi nguồn
const sourceCounts: Record<string, number> = {};
tips.forEach((tip) => {
  const srcId = tip.source.id;
  sourceCounts[srcId] = (sourceCounts[srcId] || 0) + 1;
});
---

<Layout lang={lang} title="Nguồn dữ liệu & Minh bạch" description="Danh sách các trang tin, blog công nghệ uy tín đang được hệ thống theo dõi và tổng hợp tự động.">
  <!-- Header -->
  <header class="mb-10 pb-6 border-b border-[var(--border-color)]">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[var(--accent-bg)] text-[var(--accent)] border border-[var(--accent-border)] text-xs font-mono font-semibold mb-3">
      <span>🌐 Minh bạch nguồn cấp dữ liệu</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[var(--text-primary)] mb-3">
      Nguồn dữ liệu theo dõi
    </h1>
    <p class="text-sm sm:text-base text-[var(--text-secondary)] max-w-2xl leading-relaxed">
      Tech Tips Hub thu thập thông tin từ các kênh RSS/API công khai của các trang tin công nghệ và cộng đồng kỹ thuật hàng đầu. Hệ thống tuân thủ nghiêm ngặt robots.txt, không cào tải ảnh lớn, giãn cách request lịch sự và luôn trỏ link trực tiếp về bài viết gốc của tác giả.
    </p>
  </header>

  <!-- Sources Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
    {sources.map((src) => {
      let domain = 'example.com';
      try {
        domain = new URL(src.site_url || src.url || '').hostname;
      } catch {}
      const faviconUrl = `https://www.google.com/s2/favicons?domain=${domain}&sz=32`;
      const tipCount = sourceCounts[src.id] || 0;

      return (
        <article
          id={src.id}
          class="bg-[var(--bg-surface)] border border-[var(--border-color)] rounded-xl p-5 shadow-craft flex flex-col justify-between hover:border-[var(--accent)] transition-colors"
        >
          <div>
            <!-- Top info -->
            <div class="flex items-center justify-between gap-2 mb-3">
              <div class="flex items-center gap-2.5">
                <img
                  src={faviconUrl}
                  alt=""
                  width="20"
                  height="20"
                  class="w-5 h-5 rounded"
                  onerror="this.style.display='none'"
                />
                <h3 class="text-base font-bold font-serif text-[var(--text-primary)]">
                  {src.name}
                </h3>
              </div>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-mono font-semibold border border-[var(--border-color)] bg-[var(--bg-muted)] text-[var(--text-secondary)]">
                {src.lang?.toUpperCase()}
              </span>
            </div>

            <!-- Description -->
            <p class="text-xs text-[var(--text-secondary)] leading-relaxed mb-4">
              {src.description || 'Kênh chia sẻ thủ thuật và tin tức công nghệ thực tiễn.'}
            </p>

            <!-- Categories -->
            <div class="flex flex-wrap items-center gap-1.5 mb-4">
              {(src.categories || []).map((cat) => (
                <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-[var(--bg-muted)] text-[var(--text-muted)] border border-[var(--border-subtle)]">
                  #{cat}
                </span>
              ))}
            </div>
          </div>

          <!-- Bottom Meta & Links -->
          <div class="pt-3 border-t border-[var(--border-subtle)] flex items-center justify-between text-xs">
            <span class="font-mono text-[var(--text-muted)]">
              {tipCount} thủ thuật đang hiển thị
            </span>
            <div class="flex items-center gap-3">
              {src.site_url && (
                <a
                  href={src.site_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-[var(--accent)] hover:underline inline-flex items-center gap-1"
                >
                  <span>Website</span>
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                    <polyline points="15 3 21 3 21 9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></line>
                  </svg>
                </a>
              )}
            </div>
          </div>
        </article>
      );
    })}
  </div>

  <!-- Suggest New Source Box -->
  <section class="p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-surface)] text-center max-w-xl mx-auto shadow-craft">
    <h3 class="font-serif font-bold text-lg text-[var(--text-primary)] mb-2">
      Đề xuất thêm nguồn RSS hữu ích?
    </h3>
    <p class="text-xs text-[var(--text-secondary)] leading-relaxed mb-4">
      Bạn biết một trang blog công nghệ hoặc tác giả có nhiều bài viết chia sẻ thủ thuật hay? Hãy gửi pull request hoặc tạo issue trên GitHub để chúng mình bổ sung vào hệ thống!
    </p>
    <a
      href="https://github.com"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-bold bg-[var(--accent)] text-white hover:bg-[var(--accent-hover)] transition-colors shadow-sm"
    >
      <span>Đóng góp nguồn trên GitHub</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        <polyline points="15 3 21 3 21 9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polyline>
        <line x1="10" y1="14" x2="21" y2="3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></line>
      </svg>
    </a>
  </section>
</Layout>

