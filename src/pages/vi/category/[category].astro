---
import Layout from '../../../layouts/Layout.astro';
import TipCard from '../../../components/TipCard.astro';
import { getAllTips, getAllCategories, type Category, type Tip } from '../../../lib/data';
import { getTranslations } from '../../../lib/i18n';

export async function getStaticPaths() {
  const categories = getAllCategories();
  const tips = getAllTips();

  return categories.map((cat) => {
    const catTips = tips.filter((t) => t.categories.includes(cat.id));
    return {
      params: { category: cat.id },
      props: { category: cat, tips: catTips },
    };
  });
}

interface Props {
  category: Category;
  tips: Tip[];
}

const { category, tips } = Astro.props;
const lang = 'vi';
const t = getTranslations(lang);
const allCategories = getAllCategories();
---

<Layout lang={lang} title={`Thủ thuật ${category.name.vi}`} description={category.description.vi}>
  <div class="max-w-4xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="mb-6 flex items-center gap-2 text-xs font-mono text-[var(--text-muted)]" aria-label="Breadcrumb">
      <a href={`/${lang}`} class="hover:text-[var(--text-primary)] transition-colors flex items-center gap-1">
        <span>←</span>
        <span>thủ-thuật</span>
      </a>
      <span>/</span>
      <span class="text-[var(--text-secondary)] lowercase">{category.id}</span>
      <span>/</span>
    </nav>

    <!-- Category Header -->
    <header class="mb-8 pb-6 border-b border-[var(--border-color)]">
      <div class="text-xs font-mono font-bold text-[var(--accent)] mb-2">
        $ filter --category={category.id}
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--text-primary)] tracking-tight mb-2">
        Thủ thuật {category.name.vi}
      </h1>
      <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed font-mono">
        {category.description.vi}
      </p>
      <div class="mt-3 text-xs font-mono text-[var(--text-muted)]">
        {tips.length} bài viết đã chọn lọc trong danh mục
      </div>
    </header>

    <!-- Other Categories Quick Filter Pills -->
    <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 scrollbar-none font-mono text-xs">
      <a
        href={`/${lang}`}
        class="shrink-0 px-3 py-1.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
      >
        ← Tất cả
      </a>
      {allCategories.map((c) => (
        <a
          href={`/${lang}/category/${c.id}`}
          class={`shrink-0 px-3 py-1.5 rounded-xl border transition-colors ${
            c.id === category.id
              ? 'border-transparent bg-[var(--accent-hero)] text-black font-bold shadow-sm'
              : 'border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]'
          }`}
        >
          #{c.id}
        </a>
      ))}
    </div>

    <!-- Tips Stream List -->
    <div class="space-y-4">
      {tips.map((tip) => (
        <TipCard tip={tip} lang={lang} />
      ))}
    </div>
  </div>
</Layout>
