---
import Layout from '../../../layouts/Layout.astro';
import { getAllTips, type Tip } from '../../../lib/data';
import { getTranslations } from '../../../lib/i18n';

export async function getStaticPaths() {
  const tips = getAllTips();
  return tips.map((tip) => ({
    params: { id: tip.id },
    props: { tip },
  }));
}

interface Props {
  tip: Tip;
}

const { tip } = Astro.props;
const lang = 'vi';
const t = getTranslations(lang);

const allTips = getAllTips();
const relatedTips = allTips
  .filter((tItem) => tItem.id !== tip.id && tItem.categories.some((c) => tip.categories.includes(c)))
  .slice(0, 3);

const titleText = tip.title[lang] || tip.title['en'] || Object.values(tip.title)[0] || '';
const origTitle = tip.title[tip.original_lang] || tip.title['en'] || titleText;

const summaryText = tip.summary[lang] || tip.summary['en'] || Object.values(tip.summary)[0] || '';
const origSummary = tip.summary[tip.original_lang] || tip.summary['en'] || summaryText;

const isMachineTranslated = tip.translated && tip.translated[lang] === 'machine';
const pageCanonicalUrl = `https://tech-tips-hub.pages.dev/vi/tip/${tip.id}`;

// Format date
let formattedDate = '';
try {
  const d = new Date(tip.published_at);
  if (!isNaN(d.getTime())) {
    const day = String(d.getDate()).padStart(2, '0');
    const month = String(d.getMonth() + 1).padStart(2, '0');
    const year = d.getFullYear();
    formattedDate = `${day}/${month}/${year}`;
  }
} catch {
  formattedDate = '';
}

const primaryCat = tip.categories[0] || 'thủ-thuật';
---

<Layout lang={lang} title={titleText} description={summaryText}>
  <div class="max-w-6xl mx-auto">
    <!-- Breadcrumb with Back Arrow (Matching Mockup Page 6: ← thủ-thuật / windows /) -->
    <nav class="mb-6 flex items-center gap-2 text-xs font-mono text-[var(--text-muted)]" aria-label="Breadcrumb">
      <a href={`/${lang}`} class="hover:text-[var(--text-primary)] transition-colors flex items-center gap-1">
        <span>←</span>
        <span>thủ-thuật</span>
      </a>
      <span>/</span>
      <span class="text-[var(--text-secondary)] lowercase">{primaryCat}</span>
      <span>/</span>
    </nav>

    <!-- Main Content & Sidebar Layout (Matching Mockup Page 6) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12 items-start">
      <!-- Left 2 Cols: Main Tip Content -->
      <article class="lg:col-span-2 space-y-6">
        <!-- Meta Row: source · author · date -->
        <div class="text-xs font-mono text-[var(--text-muted)] lowercase flex items-center gap-2 flex-wrap">
          <span class="text-[var(--text-secondary)] font-medium">{tip.source.name}</span>
          {tip.author && (
            <>
              <span>·</span>
              <span>{tip.author}</span>
            </>
          )}
          {formattedDate && (
            <>
              <span>·</span>
              <span>{formattedDate}</span>
            </>
          )}
        </div>

        <!-- Huge Headline -->
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[var(--text-primary)] tracking-tight leading-snug" id="tip-headline">
          {titleText}
        </h1>

        <!-- Tags & Difficulty -->
        <div class="flex items-center gap-2.5 flex-wrap text-xs font-mono">
          {tip.categories.map((cat) => (
            <span class="text-[var(--text-muted)]">
              #{cat}
            </span>
          ))}
          {tip.tags.map((tag) => (
            <span class="text-[var(--text-muted)]">
              #{tag}
            </span>
          ))}
          {tip.difficulty && (
            <span class="text-[var(--text-secondary)] font-semibold ml-1">
              Độ khó: {t.difficulty[tip.difficulty]}
            </span>
          )}
        </div>

        <!-- Bilingual Tabs Toggle (Matching Mockup Page 6) -->
        {tip.original_lang !== 'vi' && (
          <div class="inline-flex p-0.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] text-xs font-mono" id="bilingual-tabs">
            <button
              id="tab-vi"
              type="button"
              class="px-3 py-1.5 rounded-lg transition-all bg-[var(--accent-hero)] text-black font-bold shadow-sm"
            >
              Tiếng Việt {isMachineTranslated ? '(dịch tự động)' : ''}
            </button>
            <button
              id="tab-orig"
              type="button"
              class="px-3 py-1.5 rounded-lg transition-all text-[var(--text-muted)] hover:text-[var(--text-primary)]"
            >
              Bản gốc
            </button>
          </div>
        )}

        <!-- Summary Box -->
        <div class="rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-5">
          <h2 class="text-[11px] font-mono font-bold tracking-wider text-[var(--text-muted)] uppercase mb-2">
            TÓM TẮT
          </h2>
          <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed" id="tip-summary-text">
            {summaryText}
          </p>
        </div>

        <!-- Big Golden Callout Box (Matching Mockup Page 6) -->
        <div class="rounded-2xl bg-[var(--accent-hero)] text-[#0e0f13] p-6 sm:p-7 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5 shadow-sm">
          <div class="space-y-1">
            <h3 class="font-bold text-lg text-[#0e0f13]">
              Bài đầy đủ nằm ở nguồn gốc
            </h3>
            <p class="text-xs sm:text-sm text-[#1c1d22] font-medium leading-relaxed max-w-md">
              Hãy đọc tại {tip.source.name} để ủng hộ tác giả và xem đủ các bước hướng dẫn.
            </p>
          </div>

          <a
            href={tip.url}
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 px-5 py-2.5 rounded-xl bg-black text-white hover:bg-zinc-800 transition-colors font-bold text-xs inline-flex items-center gap-1.5 shadow-sm"
          >
            <span>Đọc bài gốc tại {tip.source.name} ↗</span>
          </a>
        </div>

        <!-- Action Row (Matching Mockup Page 6) -->
        <div class="flex items-center gap-2 pt-2 text-xs font-mono flex-wrap">
          <button
            type="button"
            class="bookmark-btn px-3 py-1.5 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] transition-all inline-flex items-center gap-1.5"
            data-id={tip.id}
          >
            <span>Lưu để xem sau</span>
          </button>

          <button
            type="button"
            id="share-btn"
            class="px-3 py-1.5 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] transition-all"
            data-url={pageCanonicalUrl}
          >
            Chia sẻ
          </button>

          <a
            href={`https://github.com/nhattranhuynhthien/tech-tips-hub/issues/new?title=Report+Translation+Issue+${tip.id}`}
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] transition-all"
          >
            Báo lỗi dịch
          </a>
        </div>

        <!-- Giscus Comments Placeholder (Matching Mockup Page 6) -->
        <div class="mt-8 pt-8 border-t border-[var(--border-color)]">
          <div class="rounded-xl border border-dashed border-[var(--border-color)] bg-[var(--bg-surface)] p-6 text-center text-xs font-mono text-[var(--text-muted)]">
            [Khung bình luận Giscus]
          </div>
        </div>
      </article>

      <!-- Right 1 Col: Sidebar (Matching Mockup Page 6) -->
      <aside class="space-y-6">
        <!-- Box 1: CÙNG CHỦ ĐỀ -->
        <div class="rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-5">
          <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--text-muted)] mb-4">
            CÙNG CHỦ ĐỀ
          </h3>
          <ul class="space-y-4">
            {relatedTips.map((r) => (
              <li class="border-b border-[var(--border-subtle)] pb-3 last:border-b-0 last:pb-0">
                <a
                  href={`/${lang}/tip/${r.id}`}
                  class="text-xs sm:text-sm font-bold text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors leading-snug block mb-1"
                >
                  {r.title[lang] || r.title['en']}
                </a>
                <span class="text-[11px] font-mono text-[var(--text-muted)]">
                  {r.source.name}
                </span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Box 2: VỀ BẢN TÓM TẮT NÀY -->
        <div class="rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-5">
          <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--text-muted)] mb-3">
            VỀ BẢN TÓM TẮT NÀY
          </h3>
          <p class="text-xs font-mono text-[var(--text-secondary)] leading-relaxed">
            Tech Tips Hub chỉ lưu tiêu đề và tóm tắt ngắn. Bản dịch tự động có thể chưa chính xác; hãy đối chiếu với bài gốc.
          </p>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ titleText, origTitle, summaryText, origSummary }}>
  (function () {
    const tabVi = document.getElementById('tab-vi');
    const tabOrig = document.getElementById('tab-orig');
    const headline = document.getElementById('tip-headline');
    const summary = document.getElementById('tip-summary-text');
    const shareBtn = document.getElementById('share-btn');

    tabVi?.addEventListener('click', () => {
      tabVi.className = 'px-3 py-1.5 rounded-lg transition-all bg-[var(--accent-hero)] text-black font-bold shadow-sm';
      if (tabOrig) tabOrig.className = 'px-3 py-1.5 rounded-lg transition-all text-[var(--text-muted)] hover:text-[var(--text-primary)]';
      if (headline) headline.textContent = titleText;
      if (summary) summary.textContent = summaryText;
    });

    tabOrig?.addEventListener('click', () => {
      tabOrig.className = 'px-3 py-1.5 rounded-lg transition-all bg-[var(--accent-hero)] text-black font-bold shadow-sm';
      if (tabVi) tabVi.className = 'px-3 py-1.5 rounded-lg transition-all text-[var(--text-muted)] hover:text-[var(--text-primary)]';
      if (headline) headline.textContent = origTitle;
      if (summary) summary.textContent = origSummary;
    });

    shareBtn?.addEventListener('click', () => {
      const url = shareBtn.getAttribute('data-url') || window.location.href;
      if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(() => {
          shareBtn.textContent = 'Đã sao chép link!';
          setTimeout(() => {
            shareBtn.textContent = 'Chia sẻ';
          }, 2000);
        });
      }
    });
  })();
</script>
