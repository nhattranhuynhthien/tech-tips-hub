---
import { SITE_URL } from '../lib/constants';

// Trang gốc chỉ đóng vai trò chuyển hướng sang bản tiếng Việt.
// Nội dung thật nằm ở /vi và /en để tránh trùng lặp với trang chủ.
const canonicalUrl = `${SITE_URL}/vi`;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>tips.hub — Sổ tay thủ thuật công nghệ</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content="0; url=/vi" />
    <script is:inline>location.replace('/vi');</script>
  </head>
  <body style="background:#0F1114;color:#ECEAE4;font-family:system-ui,sans-serif;display:flex;min-height:100vh;align-items:center;justify-content:center">
    <p>Đang chuyển hướng tới <a href="/vi" style="color:#FFB547">/vi</a>…</p>
  </body>
</html>
