---
import Layout from '../layouts/Layout.astro';
import TipCard from '../components/TipCard.astro';
import { getAllTips } from '../lib/data';
import { getTranslations } from '../lib/i18n';

const lang = 'vi';
const t = getTranslations(lang);
const tips = getAllTips(false).slice(0, 20);
const latestUpdate = tips.map((tip) => tip.fetched_at).filter(Boolean).sort().at(-1) || '';
---

<Layout lang={lang} title={t.site.title} description={t.site.description} canonicalPath="/">
  <section class="max-w-6xl mx-auto">
    <header class="mb-6 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
      <div>
        <p class="text-xs font-mono font-bold text-[var(--accent)] mb-2">$ latest tech tips</p>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--text-primary)] tracking-tight">Tech Tips Hub</h1>
        <p class="mt-2 text-sm text-[var(--text-secondary)]">Mẹo công nghệ mới nhất, có ghi nguồn và link bài gốc.</p>
        {latestUpdate && <p class="mt-2 text-[11px] text-[var(--text-muted)] font-mono">Cập nhật gần nhất: <time datetime={latestUpdate}>{new Date(latestUpdate).toLocaleString('vi-VN')}</time></p>}
      </div>
      <nav class="flex gap-2 text-xs font-mono" aria-label="Chọn ngôn ngữ">
        <a href="/vi" class="rounded-lg bg-[var(--accent-hero)] px-3 py-2 font-bold text-black">Tiếng Việt</a>
        <a href="/en" class="rounded-lg border border-[var(--border-color)] px-3 py-2 text-[var(--text-primary)]">English</a>
      </nav>
    </header>

    <div class="space-y-4">
      {tips.map((tip) => <TipCard tip={tip} lang="vi" />)}
    </div>
    <div class="mt-8 text-center">
      <a href="/vi" class="inline-flex rounded-xl bg-[var(--accent-hero)] px-4 py-2 text-sm font-bold text-black">Xem toàn bộ thủ thuật</a>
    </div>
  </section>
</Layout>
