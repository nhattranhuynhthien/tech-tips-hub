---
// Root page: Tự động chuyển hướng tới /vi hoặc /en theo thiết lập ngôn ngữ của trình duyệt
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0; url=/vi" />
    <title>Tech Tips Hub</title>
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('techtips_lang');
        if (stored === 'en') {
          window.location.replace('/en');
          return;
        }
        if (stored === 'vi') {
          window.location.replace('/vi');
          return;
        }
        const navLang = navigator.language || '';
        if (navLang.startsWith('en')) {
          window.location.replace('/en');
        } else {
          window.location.replace('/vi');
        }
      })();
    </script>
  </head>
  <body class="bg-[#0F1114] flex items-center justify-center min-h-screen text-[#ECEAE4] font-mono text-sm">
    <p>$ redirecting to tips.hub...</p>
  </body>
</html>

