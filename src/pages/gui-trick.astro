---
import Layout from '../layouts/Layout.astro';
const lang = 'vi';
const botUsername = (import.meta.env.PUBLIC_TELEGRAM_BOT_USERNAME || '').replace(/^@/, '');
const botUrl = botUsername ? `https://t.me/${botUsername}` : '';
---
<Layout lang={lang} title="Gửi mẹo công nghệ" description="Gửi mẹo qua Telegram để quản trị viên xem xét.">
  <article class="max-w-3xl mx-auto space-y-5">
    <p class="text-xs font-mono font-bold text-[var(--accent)]">$ community/inbox</p>
    <h1 class="text-3xl font-extrabold text-[var(--text-primary)]">Gửi mẹo công nghệ</h1>
    <p class="text-sm leading-relaxed text-[var(--text-secondary)]">Gửi link từ Telegram, Facebook hoặc web kèm tóm tắt do bạn tự viết. Bạn cũng có thể forward bài từ một kênh Telegram công khai. Quản trị viên duyệt thủ công trước khi bài được đăng.</p>
    <p class="text-sm leading-relaxed text-[var(--text-secondary)]">Không gửi toàn văn. Bot không tải nội dung Facebook; chỉ lưu link và mô tả bạn cung cấp. Tên người gửi không hiển thị công khai.</p>
    {botUrl ? <a href={botUrl} target="_blank" rel="noopener noreferrer" class="inline-flex rounded-xl bg-[var(--accent-hero)] px-4 py-2 text-sm font-bold text-black">Mở Telegram bot ↗</a> : <p class="text-sm text-[var(--text-muted)]">Telegram bot sẽ xuất hiện tại đây sau khi được cấu hình.</p>}
  </article>
</Layout>
