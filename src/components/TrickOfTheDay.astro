---
import type { Tip } from '../lib/data';
import type { Locale } from '../lib/i18n';
import { getTranslations } from '../lib/i18n';

interface Props {
  tip: Tip;
  lang: Locale;
}

const { tip, lang } = Astro.props;
const t = getTranslations(lang);

const titleText = tip.title[lang] || tip.title['en'] || '';
const summaryText = tip.summary[lang] || tip.summary['en'] || '';

let sourceDomain = 'example.com';
try {
  sourceDomain = new URL(tip.url).hostname;
} catch {}
const faviconUrl = `https://www.google.com/s2/favicons?domain=${sourceDomain}&sz=32`;
---

<section class="mb-10 relative overflow-hidden rounded-2xl border-2 border-[var(--accent)] bg-[var(--bg-surface)] p-6 sm:p-8 shadow-craft transition-colors">
  <!-- Decorative top stamp label -->
  <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-[var(--accent)] text-white text-xs font-mono font-bold tracking-wider uppercase shadow-sm">
      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
      </svg>
      <span>{t.home.trick_of_day}</span>
    </div>

    <!-- Source and difficulty -->
    <div class="flex items-center gap-3 text-xs">
      <div class="flex items-center gap-1.5 font-medium text-[var(--text-secondary)]">
        <img src={faviconUrl} alt="" width="16" height="16" class="w-4 h-4 rounded-sm" onerror="this.style.display='none'" />
        <span>{tip.source.name}</span>
      </div>
      <span class="font-mono text-[var(--text-muted)]">·</span>
      <span class="capitalize font-mono text-[var(--accent)] font-semibold">
        {tip.categories.join(', ')}
      </span>
    </div>
  </div>

  <!-- Title -->
  <h2 class="text-xl sm:text-2xl lg:text-3xl font-serif font-bold leading-tight mb-3 text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors">
    <a href={`/${lang}/tip/${tip.id}`}>
      {titleText}
    </a>
  </h2>

  <!-- Summary -->
  <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed mb-6 max-w-3xl">
    {summaryText}
  </p>

  <!-- Bottom Action & Meta -->
  <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-[var(--border-subtle)]">
    <div class="flex items-center gap-2">
      <span class="text-xs text-[var(--text-muted)] font-mono">
        {t.detail.difficulty}:
      </span>
      <span class="text-xs font-semibold px-2 py-0.5 rounded border border-[var(--border-color)] bg-[var(--bg-muted)] text-[var(--text-secondary)]">
        {t.difficulty[tip.difficulty]}
      </span>
      <span class="text-xs text-[var(--text-muted)] font-mono ml-2">
        ~{tip.reading_time_min} {t.home.reading_time}
      </span>
    </div>

    <div class="flex items-center gap-3">
      <a
        href={`/${lang}/tip/${tip.id}`}
        class="px-4 py-2 rounded-lg text-xs font-medium border border-[var(--border-color)] text-[var(--text-primary)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors"
      >
        {t.card.view_details}
      </a>
      <a
        href={tip.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-bold bg-[var(--accent)] text-white hover:bg-[var(--accent-hover)] transition-all shadow-sm"
      >
        <span>{t.card.read_original}</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          <polyline points="15 3 21 3 21 9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></polyline>
          <line x1="10" y1="14" x2="21" y2="3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></line>
        </svg>
      </a>
    </div>
  </div>
</section>
