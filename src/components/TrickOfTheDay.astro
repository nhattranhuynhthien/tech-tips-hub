---
import type { Tip } from '../lib/data';
import type { Locale } from '../lib/i18n';
import { getTranslations } from '../lib/i18n';

interface Props {
  tip: Tip;
  lang: Locale;
  kind?: 'tips' | 'news';
}

const { tip, lang, kind = 'tips' } = Astro.props;
const t = getTranslations(lang);

const titleText = tip.title[lang] || tip.title['en'] || Object.values(tip.title)[0] || '';
const summaryText = tip.summary[lang] || tip.summary['en'] || Object.values(tip.summary)[0] || '';

// Format date in DD/MM format matching mockup "TINH TẾ · 29/10"
let formattedDate = '';
try {
  const d = new Date(tip.published_at);
  if (!isNaN(d.getTime())) {
    const day = String(d.getDate()).padStart(2, '0');
    const month = String(d.getMonth() + 1).padStart(2, '0');
    formattedDate = `${day}/${month}`;
  }
} catch {
  formattedDate = '';
}

const sourceUpper = (tip.source.name || 'TECH TIPS').toUpperCase();
const featuredLabel = kind === 'news'
  ? (lang === 'vi' ? 'TIN HOT TRONG NGÀY' : 'TECH NEWS OF THE DAY')
  : (lang === 'vi' ? 'MẸO HAY HÔM NAY' : 'TRICK OF THE DAY');
const metaString = formattedDate
  ? `${featuredLabel} · ${sourceUpper} · ${formattedDate}`
  : `${featuredLabel} · ${sourceUpper}`;
---

<section class="mb-10 relative overflow-hidden rounded-2xl bg-[var(--accent-hero)] text-[#0e0f13] p-6 sm:p-8 shadow-sm">
  <div class="max-w-4xl flex flex-col md:flex-row md:items-center justify-between gap-6">
    <div class="flex-1">
      <!-- Top Meta Line: Uppercase & Monospace -->
      <div class="text-[11px] sm:text-xs font-mono font-bold tracking-wider uppercase text-[#1c1d22]/80 mb-3">
        {metaString}
      </div>

      <!-- Large Bold Headline -->
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-[#0e0f13] leading-snug mb-3">
        <a href={`/${lang}/tip/${tip.slug || tip.id}`} class="hover:underline">
          {titleText}
        </a>
      </h2>

      <!-- Lead Excerpt -->
      <p class="text-sm sm:text-base text-[#1c1d22] leading-relaxed max-w-2xl font-medium">
        {summaryText}
      </p>
    </div>

    <!-- Right Call To Action Button -->
    <div class="shrink-0 flex items-center md:self-end">
      <a
        href={tip.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-black text-white hover:bg-zinc-800 transition-colors font-bold text-xs sm:text-sm shadow-md"
      >
        <span>{lang === 'vi' ? 'Đọc bài gốc →' : 'Read original →'}</span>
      </a>
    </div>
  </div>
</section>
