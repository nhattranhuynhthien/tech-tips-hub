---
interface Props {
  currentPage: number;
  lastPage: number;
  totalItems: number;
  pageSize?: number;
  basePath: string; // e.g. "/vi" or "/en"
  lang?: string;
}

const {
  currentPage,
  lastPage,
  totalItems,
  pageSize = 20,
  basePath,
  lang = 'vi',
} = Astro.props;

if (lastPage <= 1) {
  return null;
}

const isVi = lang === 'vi';
const prevText = isVi ? 'Trước' : 'Prev';
const nextText = isVi ? 'Sau' : 'Next';
const pageOfText = isVi ? `trang ${currentPage} / ${lastPage} · ${pageSize} bài mỗi trang` : `page ${currentPage} / ${lastPage} · ${pageSize} items per page`;

const prevUrl = currentPage > 1 ? (currentPage === 2 ? `${basePath}` : `${basePath}/page/${currentPage - 1}`) : null;
const nextUrl = currentPage < lastPage ? `${basePath}/page/${currentPage + 1}` : null;

// Thuật toán sinh danh sách số trang kèm dấu ...
function getPageNumbers(current: number, total: number): (number | '...')[] {
  if (total <= 7) {
    return Array.from({ length: total }, (_, i) => i + 1);
  }
  const pages: (number | '...')[] = [];
  pages.push(1);
  if (current > 3) {
    pages.push('...');
  }
  const start = Math.max(2, current - 1);
  const end = Math.min(total - 1, current + 1);
  for (let i = start; i <= end; i++) {
    pages.push(i);
  }
  if (current < total - 2) {
    pages.push('...');
  }
  pages.push(total);
  return pages;
}

const pageNumbers = getPageNumbers(currentPage, lastPage);
---

<nav aria-label={isVi ? 'Phân trang' : 'Pagination'} class="mt-12 flex flex-col items-center gap-3">
  <!-- Desktop Pagination Links (Touch target >= 44x44px) -->
  <div class="hidden sm:flex items-center gap-2 font-mono text-xs">
    {prevUrl ? (
      <a
        href={prevUrl}
        rel="prev"
        class="h-11 px-4 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-primary)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-all flex items-center gap-1.5 focus-visible:outline focus-visible:outline-3 focus-visible:outline-[var(--accent)]"
      >
        <span>←</span>
        <span>{prevText}</span>
      </a>
    ) : (
      <span class="h-11 px-4 rounded-xl border border-[var(--border-color)] bg-[var(--bg-muted)] text-[var(--text-muted)] cursor-not-allowed opacity-50 flex items-center gap-1.5 select-none">
        <span>←</span>
        <span>{prevText}</span>
      </span>
    )}

    {pageNumbers.map((p) => {
      if (p === '...') {
        return <span class="w-11 h-11 flex items-center justify-center text-[var(--text-muted)] select-none">…</span>;
      }
      const isCurrent = p === currentPage;
      const url = p === 1 ? `${basePath}` : `${basePath}/page/${p}`;
      return (
        <a
          href={url}
          aria-current={isCurrent ? 'page' : undefined}
          class={`min-w-[44px] h-11 px-2 flex items-center justify-center rounded-xl transition-all font-semibold ${
            isCurrent
              ? 'bg-[var(--accent)] text-[var(--on-accent)] font-bold shadow-sm'
              : 'border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:border-[var(--accent)] hover:text-[var(--text-primary)]'
          } focus-visible:outline focus-visible:outline-3 focus-visible:outline-[var(--accent)]`}
        >
          {p}
        </a>
      );
    })}

    {nextUrl ? (
      <a
        href={nextUrl}
        rel="next"
        class="h-11 px-4 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-primary)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-all flex items-center gap-1.5 focus-visible:outline focus-visible:outline-3 focus-visible:outline-[var(--accent)]"
      >
        <span>{nextText}</span>
        <span>→</span>
      </a>
    ) : (
      <span class="h-11 px-4 rounded-xl border border-[var(--border-color)] bg-[var(--bg-muted)] text-[var(--text-muted)] cursor-not-allowed opacity-50 flex items-center gap-1.5 select-none">
        <span>{nextText}</span>
        <span>→</span>
      </span>
    )}
  </div>

  <!-- Mobile Compact Pagination: ← Trước | N / TỔNG | Sau → -->
  <div class="sm:hidden flex items-center justify-between w-full max-w-xs font-mono text-xs border border-[var(--border-color)] bg-[var(--bg-surface)] rounded-xl p-1 shadow-sm">
    {prevUrl ? (
      <a href={prevUrl} rel="prev" class="h-11 px-3.5 flex items-center rounded-lg text-[var(--text-primary)] hover:bg-[var(--bg-muted)] transition-colors">
        ← {prevText}
      </a>
    ) : (
      <span class="h-11 px-3.5 flex items-center text-[var(--text-muted)] opacity-50 select-none">
        ← {prevText}
      </span>
    )}

    <span class="text-[var(--accent)] font-bold text-xs tracking-wider">
      {currentPage} / {lastPage}
    </span>

    {nextUrl ? (
      <a href={nextUrl} rel="next" class="h-11 px-3.5 flex items-center rounded-lg text-[var(--text-primary)] hover:bg-[var(--bg-muted)] transition-colors">
        {nextText} →
      </a>
    ) : (
      <span class="h-11 px-3.5 flex items-center text-[var(--text-muted)] opacity-50 select-none">
        {nextText} →
      </span>
    )}
  </div>

  <!-- Subtitle Line: trang N / TỔNG · 20 bài mỗi trang -->
  <div class="text-[11px] font-mono text-[var(--text-muted)]">
    {pageOfText}
  </div>
</nav>

