---
import type { Locale } from '../lib/i18n';
import { getTranslations } from '../lib/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<div id="search-modal" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-sm transition-opacity font-mono" role="dialog" aria-modal="true" aria-label={t.nav.search}>
  <div class="min-h-screen px-4 text-center sm:block sm:p-0">
    <!-- Click backdrop to close -->
    <div id="search-backdrop" class="fixed inset-0" aria-hidden="true"></div>

    <div class="inline-block w-full max-w-2xl my-12 overflow-hidden text-left align-middle transition-all transform bg-[var(--bg-surface)] border border-[var(--border-color)] rounded-2xl shadow-2xl relative z-10">
      <!-- Search Input Header -->
      <div class="flex items-center px-4 py-3 border-b border-[var(--border-color)] bg-[var(--bg-muted)]">
        <span class="text-[var(--accent)] font-bold text-lg mr-3 select-none">$</span>
        <input
          id="search-input"
          type="search"
          placeholder={lang === 'vi' ? 'Tìm thủ thuật, phím tắt, terminal, Docker...' : 'Search tips, shortcuts, terminal, Docker...'}
          class="w-full bg-transparent text-base text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none font-mono"
          autocomplete="off"
        />
        <button id="search-close-btn" class="p-1 text-[var(--text-muted)] hover:text-[var(--text-primary)] rounded-md transition-colors" aria-label="Đóng tìm kiếm">
          <kbd class="text-xs">Esc</kbd>
        </button>
      </div>

      <!-- Live Search Results List -->
      <div id="search-results" class="max-h-96 overflow-y-auto p-3 space-y-2 divide-y divide-[var(--border-subtle)]">
        <div id="search-empty-state" class="py-8 text-center text-xs text-[var(--text-muted)] font-mono">
          {lang === 'vi' ? 'Nhập từ khóa để tìm kiếm thủ thuật tức thì...' : 'Type a query to search handcrafted tips instantly...'}
        </div>
      </div>

      <!-- Search Modal Footer -->
      <div class="px-4 py-2 text-xs text-[var(--text-muted)] bg-[var(--bg-muted)] border-t border-[var(--border-color)] flex justify-between items-center font-mono">
        <div class="flex items-center gap-2">
          <span><kbd class="text-[10px]">↑</kbd> <kbd class="text-[10px]">↓</kbd> {lang === 'vi' ? 'di chuyển' : 'navigate'}</span>
          <span><kbd class="text-[10px]">Enter</kbd> {lang === 'vi' ? 'chọn' : 'select'}</span>
        </div>
        <span class="text-[11px] text-[var(--accent)] font-bold">tips.hub instant search</span>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ lang }}>
  (function () {
    let allTips = [];
    let isLoaded = false;
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('search-input');
    const resultsContainer = document.getElementById('search-results');
    const openBtn = document.getElementById('open-search-btn');
    const closeBtn = document.getElementById('search-close-btn');
    const backdrop = document.getElementById('search-backdrop');

    async function loadTips() {
      if (isLoaded) return;
      try {
        const resp = await fetch('/api/tips.json');
        if (resp.ok) {
          allTips = await resp.json();
          isLoaded = true;
        }
      } catch (err) {
        console.error('Failed to load tips for search:', err);
      }
    }

    function openModal() {
      modal?.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
      loadTips();
      setTimeout(() => input?.focus(), 50);
    }

    function closeModal() {
      modal?.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
      if (input) input.value = '';
      if (resultsContainer) {
        resultsContainer.innerHTML = `<div id="search-empty-state" class="py-8 text-center text-xs text-[var(--text-muted)] font-mono">${
          lang === 'vi' ? 'Nhập từ khóa để tìm kiếm thủ thuật tức thì...' : 'Type a query to search handcrafted tips instantly...'
        }</div>`;
      }
    }

    // Keyboard Shortcuts (/ or Ctrl+K to open, Esc to close)
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal?.classList.contains('hidden')) {
        closeModal();
      } else if (
        (e.key === '/' || ((e.metaKey || e.ctrlKey) && e.key === 'k')) &&
        modal?.classList.contains('hidden') &&
        document.activeElement?.tagName !== 'INPUT' &&
        document.activeElement?.tagName !== 'TEXTAREA'
      ) {
        e.preventDefault();
        openModal();
      }
    });

    openBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    // Live search query matching
    input?.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      if (!q) {
        resultsContainer.innerHTML = `<div id="search-empty-state" class="py-8 text-center text-xs text-[var(--text-muted)] font-mono">${
          lang === 'vi' ? 'Nhập từ khóa để tìm kiếm thủ thuật tức thì...' : 'Type a query to search handcrafted tips instantly...'
        }</div>`;
        return;
      }

      const matches = allTips
        .filter((tip) => {
          const tText = (tip.title[lang] || tip.title['en'] || '').toLowerCase();
          const sText = (tip.summary[lang] || tip.summary['en'] || '').toLowerCase();
          const cText = (tip.categories || []).join(' ').toLowerCase();
          return tText.includes(q) || sText.includes(q) || cText.includes(q);
        })
        .slice(0, 8);

      if (matches.length === 0) {
        resultsContainer.innerHTML = `<div class="py-8 text-center text-xs text-[var(--text-muted)] font-mono">${
          lang === 'vi' ? 'Không tìm thấy thủ thuật nào khớp với từ khóa.' : 'No tips matched your query.'
        }</div>`;
        return;
      }

      resultsContainer.innerHTML = matches
        .map((tip) => {
          const title = tip.title[lang] || tip.title['en'] || '';
          const summ = tip.summary[lang] || tip.summary['en'] || '';
          return `
            <a href="/${lang}/tip/${tip.id}" class="block p-3 rounded-xl hover:bg-[var(--bg-muted)] transition-colors group">
              <div class="flex items-center gap-2 text-[11px] font-mono text-[var(--text-muted)] mb-1">
                <span class="text-[var(--text-secondary)]">${tip.source.name}</span>
                <span>·</span>
                <span class="text-[var(--accent)] font-semibold">#${tip.categories[0] || 'tips'}</span>
              </div>
              <h4 class="text-sm font-bold text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors leading-snug">
                ${title}
              </h4>
              <p class="text-xs text-[var(--text-secondary)] line-clamp-1 mt-1">
                ${summ}
              </p>
            </a>
          `;
        })
        .join('');
    });
  })();
</script>
