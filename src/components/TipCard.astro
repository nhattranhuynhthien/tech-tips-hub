---
import type { Tip } from '../lib/data';
import type { Locale } from '../lib/i18n';
import { getTranslations } from '../lib/i18n';
import { SITE_URL } from '../lib/constants';

interface Props {
  tip: Tip;
  lang: Locale;
  featured?: boolean;
}

const { tip, lang, featured = false } = Astro.props;
const t = getTranslations(lang);

const titleText = tip.title[lang] || tip.title['en'] || Object.values(tip.title)[0] || '';
const summaryText = tip.summary[lang] || tip.summary['en'] || Object.values(tip.summary)[0] || '';
const isMachineTranslated = tip.translated && tip.translated[lang] === 'machine';
const isUntranslated = tip.original_lang !== lang && !isMachineTranslated;

// Format ngày đăng: DD/MM
let formattedDate = '';
try {
  const d = new Date(tip.published_at);
  if (!isNaN(d.getTime())) {
    const day = String(d.getDate()).padStart(2, '0');
    const month = String(d.getMonth() + 1).padStart(2, '0');
    formattedDate = `${day}/${month}`;
  }
} catch {
  formattedDate = '';
}

// Extract primary category
const primaryCat = tip.categories[0] || 'dev';
const contentTypeLabelMap: Record<string, string> = lang === 'vi'
  ? { community: 'Cộng đồng', video: 'Video', vendor: 'Hãng công nghệ', article: 'Bài viết' }
  : { community: 'Community', video: 'Video', vendor: 'Vendor', article: 'Article' };
const contentTypeLabel = contentTypeLabelMap[tip.source.content_type || 'article'] || contentTypeLabelMap.article;
const communitySourceLabel = tip.source_type === 'community-facebook'
  ? (lang === 'vi' ? 'Facebook' : 'Facebook')
  : tip.source_type === 'community-telegram'
    ? 'Telegram'
    : tip.source_type === 'community-web'
      ? 'Web'
      : '';
const tipCanonicalUrl = `${SITE_URL}/${lang}/tip/${tip.slug || tip.id}`;
const isActualVi = lang === 'vi' ? (tip.original_lang === 'vi' || isMachineTranslated) : true;
const sourceDomain = (() => {
  try {
    return new URL(tip.source.site_url || tip.url).hostname;
  } catch {
    return '';
  }
})();
const updatedAt = new Date(tip.fetched_at);
const formattedUpdatedAt = Number.isNaN(updatedAt.getTime())
  ? ''
  : new Intl.DateTimeFormat(lang === 'vi' ? 'vi-VN' : 'en-US', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }).format(updatedAt);
---

<article
  class="tip-card group bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--border-strong)] rounded-xl p-5 transition-all duration-200 flex flex-col justify-between"
  data-tip-id={tip.id}
  data-category={tip.categories.join(' ')}
  data-difficulty={tip.difficulty || ''}
  data-lang-display={isActualVi ? 'vi' : 'en'}
  data-original-lang={tip.original_lang}
  data-source={tip.source.id}
  data-content-type={tip.source.content_type || 'article'}
  data-pub-date={tip.published_at}
  data-score={tip.score}
>
  <div>
    <!-- Top Metadata Bar: source · date · category (Matching Mockup Page 1 & 3) -->
    <div class="flex items-center gap-2 text-xs font-mono text-[var(--text-muted)] mb-2.5 flex-wrap">
      {sourceDomain && <img src={`https://www.google.com/s2/favicons?domain=${encodeURIComponent(sourceDomain)}&sz=32`} alt="" width="16" height="16" loading="lazy" class="w-4 h-4 rounded-sm" />}
      <span class="text-[var(--text-secondary)] font-medium lowercase">{tip.source.name}</span>
      {communitySourceLabel && <span class="rounded border border-[var(--accent)]/30 px-1.5 py-0.5 text-[10px] text-[var(--accent)]">{lang === 'vi' ? 'Cộng đồng' : 'Community'} · {communitySourceLabel}</span>}
      {isUntranslated && (
        <span class="px-1.5 py-0.2 rounded text-[10px] font-mono font-bold border border-blue-500/30 bg-blue-500/10 text-blue-400">
          {lang === 'vi' ? 'Chưa dịch' : 'Not translated'}
        </span>
      )}
      {tip.alsoFrom?.length ? <span class="text-[10px] text-[var(--text-muted)]">+{tip.alsoFrom.length} {lang === 'vi' ? 'nguồn khác' : 'more sources'}</span> : null}
      {formattedDate && (
        <>
          <span>·</span>
          <span>{formattedDate}</span>
        </>
      )}
      <span>·</span>
      <span class="lowercase text-[var(--text-muted)]">{primaryCat}</span>
      {formattedUpdatedAt && <span class="text-[var(--text-muted)]">· {lang === 'vi' ? 'cập nhật' : 'updated'} {formattedUpdatedAt}</span>}
    </div>

    <!-- Title: Bold White Heading -->
    <h3 class="text-base sm:text-lg font-bold leading-snug mb-2 text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors">
      <a href={`/${lang}/tip/${tip.slug || tip.id}`} class="focus:outline-none">
        {titleText}
      </a>
    </h3>

    <!-- Summary Paragraph -->
    <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed mb-4 line-clamp-2">
      {summaryText}
    </p>
  </div>

  <!-- Bottom Row: Badges on left, 'Đọc bài gốc ↗' on right -->
  <div class="pt-3 border-t border-[var(--border-subtle)] flex items-center justify-between gap-2 text-xs font-mono">
    <div class="flex items-center gap-2 flex-wrap">
      <!-- Difficulty Badge (Task 4) -->
      {tip.difficulty ? (
        <span class="px-2 py-0.5 rounded text-[11px] border border-[var(--border-color)] bg-[var(--bg-muted)] text-[var(--text-secondary)]">
          {t.difficulty[tip.difficulty]}
        </span>
      ) : (
        <span class="px-2 py-0.5 rounded text-[11px] border border-[var(--border-subtle)] bg-[var(--bg-muted)] text-[var(--text-muted)]">
          {contentTypeLabel}
        </span>
      )}

      <!-- Translation Micro-Badge -->
      {isMachineTranslated && (
        <span class="px-2 py-0.5 rounded text-[11px] border border-[var(--border-subtle)] bg-[var(--bg-muted)] text-[var(--text-muted)]">
          {lang === 'vi' ? 'Bản dịch tự động' : 'Machine translated'}
        </span>
      )}

      <!-- HN points micro-badge if available -->
      {tip.hn_points && (
        <span class="px-2 py-0.5 rounded text-[11px] border border-amber-500/20 bg-amber-500/10 text-amber-400">
          HN: {tip.hn_points}
        </span>
      )}
    </div>

    <!-- Read Original Link (Amber / Orange) - Task 4: Accessible and clean -->
    <a
      href={tip.url}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${lang === 'vi' ? 'Đọc bài gốc' : 'Read original'}: ${titleText}`}
      class="text-[var(--accent)] hover:underline font-semibold inline-flex items-center gap-1 shrink-0 ml-auto"
    >
      <span class="hidden sm:inline" aria-hidden="true">{lang === 'vi' ? 'Đọc bài gốc' : 'Read original'}</span>
      <span class="sm:hidden" aria-hidden="true">{lang === 'vi' ? 'Bài gốc' : 'Original'}</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
