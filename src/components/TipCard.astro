---
import type { Tip } from '../lib/data';
import type { Locale } from '../lib/i18n';
import { getTranslations } from '../lib/i18n';
import { formatShortDate, formatUpdatedAt } from '../lib/dates';
import { safeExternalUrl } from '../lib/url';

interface Props {
  tip: Tip;
  lang: Locale;
}

const { tip, lang } = Astro.props;
const t = getTranslations(lang);

const titleText = tip.title[lang] || tip.title['en'] || Object.values(tip.title)[0] || '';
const summaryText = tip.summary[lang] || tip.summary['en'] || Object.values(tip.summary)[0] || '';
const isMachineTranslated = tip.translated && tip.translated[lang] === 'machine';
const isUntranslated = tip.original_lang !== lang && !isMachineTranslated;

const formattedDate = formatShortDate(tip.published_at, lang);
const formattedUpdatedAt = formatUpdatedAt(tip.fetched_at, lang);

const primaryCat = tip.categories[0] || 'dev';
const contentTypeLabelMap: Record<string, string> = lang === 'vi'
  ? { community: 'Cộng đồng', video: 'Video', vendor: 'Hãng công nghệ', article: 'Bài viết' }
  : { community: 'Community', video: 'Video', vendor: 'Vendor', article: 'Article' };
const contentTypeLabel = contentTypeLabelMap[tip.source.content_type || 'article'] || contentTypeLabelMap.article;
const communitySourceLabel = tip.source_type === 'community-facebook'
  ? 'Facebook'
  : tip.source_type === 'community-telegram'
    ? 'Telegram'
    : tip.source_type === 'community-web'
      ? 'Web'
      : '';
const isActualVi = lang === 'vi' ? (tip.original_lang === 'vi' || isMachineTranslated) : true;
const faviconSrc = tip.source?.id
  ? `/favicons/${encodeURIComponent(tip.source.id)}.png`
  : '/favicons/default.svg';
---

<article
  class="tip-card group bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--border-strong)] rounded-xl p-5 transition-all duration-200 flex flex-col justify-between"
  data-tip-id={tip.id}
  data-category={tip.categories.join(' ')}
  data-difficulty={tip.difficulty || ''}
  data-lang-display={isActualVi ? 'vi' : 'en'}
  data-original-lang={tip.original_lang}
  data-source={tip.source.id}
  data-content-type={tip.source.content_type || 'article'}
  data-pub-date={tip.published_at}
  data-score={tip.score}
>
  <div>
    <!-- Top Metadata Bar -->
    <div class="flex items-center gap-2 text-xs font-mono text-[var(--text-muted)] mb-2.5 flex-wrap tabular-nums">
      <img
        src={faviconSrc}
        data-fallback-src="/favicons/default.svg"
        alt=""
        width="16"
        height="16"
        loading="lazy"
        class="w-4 h-4 rounded-sm shrink-0"
      />
      <span class="text-[var(--text-secondary)] font-medium lowercase">{tip.source.name}</span>
      {communitySourceLabel && (
        <span class="rounded border border-[var(--accent-border)] bg-[var(--accent-bg)] px-1.5 py-0.5 text-[10px] text-[var(--accent)]">
          {lang === 'vi' ? 'Cộng đồng' : 'Community'} · {communitySourceLabel}
        </span>
      )}
      {isUntranslated && (
        <span class="px-1.5 py-0.5 rounded text-[10px] font-mono font-bold border border-[var(--badge-info-border)] bg-[var(--badge-info-bg)] text-[var(--badge-info-text)]">
          {lang === 'vi' ? 'Chưa dịch' : 'Not translated'}
        </span>
      )}
      {tip.alsoFrom?.length ? (
        <span class="text-[10px] text-[var(--text-muted)]">
          +{tip.alsoFrom.length} {lang === 'vi' ? 'nguồn khác' : 'more sources'}
        </span>
      ) : null}
      {formattedDate && (
        <>
          <span>·</span>
          <span>{formattedDate}</span>
        </>
      )}
      <span>·</span>
      <span class="lowercase text-[var(--text-muted)]">{primaryCat}</span>
      {formattedUpdatedAt && (
        <span class="text-[var(--text-muted)]">· {lang === 'vi' ? 'cập nhật' : 'updated'} {formattedUpdatedAt}</span>
      )}
    </div>

    <!-- Title -->
    <h3 class="text-base sm:text-lg font-bold leading-snug mb-2 text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors">
      <a href={`/${lang}/tip/${encodeURIComponent(tip.slug || tip.id)}`} class="block focus:outline-none">
        {titleText}
      </a>
    </h3>

    <!-- Summary Paragraph -->
    <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed mb-4 line-clamp-2">
      {summaryText}
    </p>
  </div>

  <!-- Bottom Row -->
  <div class="pt-3 border-t border-[var(--border-subtle)] flex items-center justify-between gap-2 text-xs font-mono">
    <div class="flex items-center gap-2 flex-wrap">
      {tip.difficulty ? (
        <span class="px-2 py-0.5 rounded text-[11px] border border-[var(--border-color)] bg-[var(--bg-muted)] text-[var(--text-secondary)]">
          {t.difficulty[tip.difficulty]}
        </span>
      ) : (
        <span class="px-2 py-0.5 rounded text-[11px] border border-[var(--border-subtle)] bg-[var(--bg-muted)] text-[var(--text-muted)]">
          {contentTypeLabel}
        </span>
      )}

      {isMachineTranslated && (
        <span class="px-2 py-0.5 rounded text-[11px] border border-[var(--border-subtle)] bg-[var(--bg-muted)] text-[var(--text-muted)]">
          {lang === 'vi' ? 'Bản dịch tự động' : 'Machine translated'}
        </span>
      )}

      {tip.hn_points && (
        <span class="px-2 py-0.5 rounded text-[11px] border border-[var(--badge-hn-border)] bg-[var(--badge-hn-bg)] text-[var(--badge-hn-text)] tabular-nums">
          HN: {tip.hn_points}
        </span>
      )}
    </div>

    <!-- Right Actions: Bookmark + Read Original Link -->
    <div class="flex items-center gap-2 shrink-0 ml-auto">
      <button
        type="button"
        class="bookmark-btn p-1.5 rounded-lg border border-transparent text-[var(--text-muted)] hover:text-[var(--accent)] hover:bg-[var(--bg-muted)] transition-colors"
        data-id={tip.id}
        aria-pressed="false"
        aria-label={t.card.save_tip}
        title={t.card.save_tip}
      >
        <svg class="bookmark-icon w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>

      <a
        href={safeExternalUrl(tip.url)}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${lang === 'vi' ? 'Đọc bài gốc' : 'Read original'}: ${titleText}`}
        class="text-[var(--accent)] hover:underline font-semibold inline-flex items-center gap-1"
      >
        <span class="hidden sm:inline" aria-hidden="true">{lang === 'vi' ? 'Đọc bài gốc' : 'Read original'}</span>
        <span class="sm:hidden" aria-hidden="true">{lang === 'vi' ? 'Bài gốc' : 'Original'}</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</article>
