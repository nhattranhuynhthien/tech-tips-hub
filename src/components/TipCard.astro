---
import type { Tip } from '../lib/data';
import type { Locale } from '../lib/i18n';
import { getTranslations } from '../lib/i18n';

interface Props {
  tip: Tip;
  lang: Locale;
  featured?: boolean;
}

const { tip, lang, featured = false } = Astro.props;
const t = getTranslations(lang);

const titleText = tip.title[lang] || tip.title['en'] || Object.values(tip.title)[0] || '';
const summaryText = tip.summary[lang] || tip.summary['en'] || Object.values(tip.summary)[0] || '';
const isMachineTranslated = tip.translated && tip.translated[lang] === 'machine';

// Format ngày đăng: DD/MM
let formattedDate = '';
try {
  const d = new Date(tip.published_at);
  if (!isNaN(d.getTime())) {
    const day = String(d.getDate()).padStart(2, '0');
    const month = String(d.getMonth() + 1).padStart(2, '0');
    formattedDate = `${day}/${month}`;
  }
} catch {
  formattedDate = '';
}

// Extract primary category
const primaryCat = tip.categories[0] || 'dev';
const tipCanonicalUrl = `https://tech-tips-hub.pages.dev/${lang}/tip/${tip.id}`;
---

<article
  class="tip-card group bg-[var(--bg-surface)] border border-[var(--border-color)] hover:border-[var(--border-strong)] rounded-xl p-5 transition-all duration-200 flex flex-col justify-between"
  data-tip-id={tip.id}
  data-category={tip.categories.join(' ')}
  data-difficulty={tip.difficulty || ''}
  data-pub-date={tip.published_at}
  data-score={tip.score}
>
  <div>
    <!-- Top Metadata Bar: source · date · category (Matching Mockup Page 1 & 3) -->
    <div class="flex items-center gap-2 text-xs font-mono text-[var(--text-muted)] mb-2.5 flex-wrap">
      <span class="text-[var(--text-secondary)] font-medium lowercase">{tip.source.name}</span>
      {formattedDate && (
        <>
          <span>·</span>
          <span>{formattedDate}</span>
        </>
      )}
      <span>·</span>
      <span class="lowercase text-[var(--text-muted)]">{primaryCat}</span>
    </div>

    <!-- Title: Bold White Heading -->
    <h3 class="text-base sm:text-lg font-bold leading-snug mb-2 text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors">
      <a href={`/${lang}/tip/${tip.id}`} class="focus:outline-none">
        {titleText}
      </a>
    </h3>

    <!-- Summary Paragraph -->
    <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed mb-4 line-clamp-2">
      {summaryText}
    </p>
  </div>

  <!-- Bottom Row: Badges on left, 'Đọc bài gốc ↗' on right -->
  <div class="pt-3 border-t border-[var(--border-subtle)] flex items-center justify-between gap-2 text-xs font-mono">
    <div class="flex items-center gap-2 flex-wrap">
      <!-- Difficulty Badge -->
      {tip.difficulty && (
        <span class="px-2 py-0.5 rounded text-[11px] border border-[var(--border-color)] bg-[var(--bg-muted)] text-[var(--text-secondary)]">
          {t.difficulty[tip.difficulty]}
        </span>
      )}

      <!-- Translation Micro-Badge -->
      {isMachineTranslated && (
        <span class="px-2 py-0.5 rounded text-[11px] border border-[var(--border-subtle)] bg-[var(--bg-muted)] text-[var(--text-muted)]">
          {lang === 'vi' ? 'Bản dịch tự động' : 'Machine translated'}
        </span>
      )}

      <!-- HN points micro-badge if available -->
      {tip.hn_points && (
        <span class="px-2 py-0.5 rounded text-[11px] border border-amber-500/20 bg-amber-500/10 text-amber-400">
          HN: {tip.hn_points}
        </span>
      )}
    </div>

    <!-- Read Original Link (Amber / Orange) -->
    <a
      href={tip.url}
      target="_blank"
      rel="noopener noreferrer"
      class="text-[var(--accent)] hover:underline font-semibold inline-flex items-center gap-1 shrink-0 ml-auto"
    >
      <span class="hidden sm:inline">{lang === 'vi' ? 'Đọc bài gốc' : 'Read original'}</span>
      <span class="sm:hidden">{lang === 'vi' ? 'Bài gốc' : 'Original'}</span>
      <span>↗</span>
    </a>
  </div>
</article>
