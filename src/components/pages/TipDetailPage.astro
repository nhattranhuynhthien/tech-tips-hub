---
import Layout from '../../layouts/Layout.astro';
import { getAllCategories, getAllTips, type Tip } from '../../lib/data';
import { getTranslations, type Locale } from '../../lib/i18n';
import { formatFullDate } from '../../lib/dates';
import { SITE_URL } from '../../lib/constants';
import { safeExternalUrl } from '../../lib/url';

interface Props {
  lang: Locale;
  tip: Tip;
  isCanonical: boolean;
}

const { lang, tip, isCanonical } = Astro.props;
const isVi = lang === 'vi';
const t = getTranslations(lang);

const titleText = tip.title[lang] || tip.title['en'] || Object.values(tip.title)[0] || '';
const origTitle = tip.title[tip.original_lang] || tip.title['en'] || titleText;

const summaryText = tip.summary[lang] || tip.summary['en'] || Object.values(tip.summary)[0] || '';
const origSummary = tip.summary[tip.original_lang] || tip.summary['en'] || summaryText;

const tipSlugOrId = tip.slug || tip.id;
const canonicalRelativePath = `/${lang}/tip/${encodeURIComponent(tipSlugOrId)}`;
const pageCanonicalUrl = `${SITE_URL}${canonicalRelativePath}`;

const isNewsItem = tip.source?.kind === 'news';
const validCategoryIds = new Set(getAllCategories().map((c) => c.id));
const tipCategories = Array.isArray(tip.categories) ? tip.categories : [];
const tipTags = Array.isArray(tip.tags) ? tip.tags : [];

const relatedTips = isCanonical
  ? getAllTips()
      .filter((tItem) => tItem.id !== tip.id && tItem.categories.some((c) => tipCategories.includes(c)))
      .slice(0, 3)
  : [];

function cleanPoints(list: unknown): string[] {
  if (!Array.isArray(list)) return [];
  return list
    .filter((item): item is string => typeof item === 'string' && item.trim().length > 0)
    .map((item) => item.trim());
}

const langKeyPoints = cleanPoints(tip.key_points?.[lang]);
const enKeyPoints = cleanPoints(tip.key_points?.en);
const rawOrigPoints = cleanPoints(tip.key_points?.[tip.original_lang]);

const keyPoints = langKeyPoints.length > 0 ? langKeyPoints : enKeyPoints;
const keyPointsLangCode = langKeyPoints.length > 0 ? lang : enKeyPoints.length > 0 ? 'en' : '';
const hasDistinctOrigKeyPoints = rawOrigPoints.length > 0;
const origKeyPoints = hasDistinctOrigKeyPoints ? rawOrigPoints : keyPoints;

const isMachineTranslated = tip.translated && tip.translated[lang] === 'machine';
const isUntranslated = tip.original_lang !== lang && !isMachineTranslated;
const formattedDate = formatFullDate(tip.published_at, lang);

const primaryCat = tipCategories[0] || (isVi ? 'thủ-thuật' : 'tips');
const isPrimaryCatValid = validCategoryIds.has(primaryCat);
const sectionRootPath = isNewsItem ? `/${lang}/news` : `/${lang}`;
const sectionRootLabel = isNewsItem
  ? (isVi ? 'tin-tức' : 'news')
  : (isVi ? 'thủ-thuật' : 'tips');
const primaryCatHref = isNewsItem
  ? `/${lang}/news?cat=${encodeURIComponent(primaryCat)}`
  : `/${lang}/category/${encodeURIComponent(primaryCat)}`;

const communitySourceLabel =
  tip.source_type === 'community-facebook'
    ? 'Facebook'
    : tip.source_type === 'community-telegram'
      ? 'Telegram'
      : tip.source_type === 'community-web'
        ? 'Web'
        : '';

const origLangLabel = tip.original_lang?.startsWith('zh')
  ? (isVi ? 'Bản gốc (Tiếng Trung)' : 'Original (Chinese)')
  : tip.original_lang === 'vi'
    ? (isVi ? 'Bản gốc (Tiếng Việt)' : 'Original (Vietnamese)')
    : (isVi ? 'Bản gốc (Tiếng Anh)' : 'Original (English)');

const brokenLinkParams = new URLSearchParams({
  title: `[Broken Link] ${titleText}`,
  body: (isVi
    ? [
        '## Báo link hỏng',
        '',
        `- **Tiêu đề:** ${titleText}`,
        `- **Slug / ID:** ${tipSlugOrId} (${tip.id})`,
        `- **URL gốc:** ${tip.url}`,
        `- **Trang trên Tech Tips Hub:** ${pageCanonicalUrl}`,
        '',
        '**Mô tả thêm (nếu có):**',
      ]
    : [
        '## Report Broken Link',
        '',
        `- **Title:** ${titleText}`,
        `- **Slug / ID:** ${tipSlugOrId} (${tip.id})`,
        `- **Original URL:** ${tip.url}`,
        `- **Tech Tips Hub page:** ${pageCanonicalUrl}`,
        '',
        '**Additional details (optional):**',
      ]
  ).join('\n'),
});
const reportBrokenLinkUrl = `https://github.com/nhattranhuynhthien/tech-tips-hub/issues/new?${brokenLinkParams.toString()}`;

const articleJsonLd = isCanonical
  ? [
      {
        '@context': 'https://schema.org',
        '@type': isNewsItem ? 'NewsArticle' : 'TechArticle',
        headline: titleText,
        description: summaryText,
        inLanguage: isVi ? 'vi-VN' : 'en-US',
        datePublished: tip.published_at || tip.fetched_at,
        dateModified: tip.fetched_at || tip.published_at,
        mainEntityOfPage: pageCanonicalUrl,
        url: pageCanonicalUrl,
        isBasedOn: safeExternalUrl(tip.url),
        ...(tip.author ? { author: { '@type': 'Person', name: tip.author } } : {}),
        publisher: {
          '@type': 'Organization',
          name: 'Tech Tips Hub (tips.hub)',
          url: SITE_URL,
        },
        keywords: [...tipCategories, ...tipTags].join(', '),
      },
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: sectionRootLabel,
            item: `${SITE_URL}${sectionRootPath}`,
          },
          ...(isPrimaryCatValid
            ? [
                {
                  '@type': 'ListItem',
                  position: 2,
                  name: primaryCat,
                  item: `${SITE_URL}${primaryCatHref}`,
                },
                {
                  '@type': 'ListItem',
                  position: 3,
                  name: titleText,
                  item: pageCanonicalUrl,
                },
              ]
            : [
                {
                  '@type': 'ListItem',
                  position: 2,
                  name: titleText,
                  item: pageCanonicalUrl,
                },
              ]),
        ],
      },
    ]
  : undefined;

const keyPointsInitialNote =
  keyPointsLangCode && keyPointsLangCode !== lang
    ? `(${keyPointsLangCode.toUpperCase()})`
    : '';
const keyPointsOrigNote =
  !hasDistinctOrigKeyPoints && keyPointsLangCode
    ? `(${keyPointsLangCode.toUpperCase()})`
    : '';
---

{isCanonical ? (
  <Layout
    lang={lang}
    title={titleText}
    description={summaryText}
    canonicalPath={canonicalRelativePath}
    noindex={false}
    jsonLd={articleJsonLd}
  >
    <div class="max-w-6xl mx-auto">
      <!-- Breadcrumb -->
      <nav class="mb-6 flex items-center gap-2 text-xs font-mono text-[var(--text-muted)]" aria-label="Breadcrumb">
        <a href={sectionRootPath} class="hover:text-[var(--text-primary)] transition-colors flex items-center gap-1">
          <span>←</span>
          <span>{sectionRootLabel}</span>
        </a>
        <span>/</span>
        {isPrimaryCatValid ? (
          <a
            href={primaryCatHref}
            class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors lowercase"
          >
            {primaryCat}
          </a>
        ) : (
          <span class="text-[var(--text-secondary)] lowercase">{primaryCat}</span>
        )}
        <span>/</span>
      </nav>

      <!-- Main Content & Sidebar Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12 items-start">
        <!-- Left 2 Cols: Main Tip Content -->
        <article class="lg:col-span-2 space-y-6">
          <!-- Meta Row -->
          <div class="text-xs font-mono text-[var(--text-muted)] lowercase flex items-center gap-2 flex-wrap tabular-nums">
            <span class="text-[var(--text-secondary)] font-medium">{tip.source.name}</span>
            {communitySourceLabel && (
              <span class="rounded border border-[var(--accent-border)] bg-[var(--accent-bg)] px-1.5 py-0.5 text-[10px] text-[var(--accent)]">
                {isVi ? 'Cộng đồng đóng góp' : 'Community submission'} · {communitySourceLabel}
              </span>
            )}
            {tip.alsoFrom?.map((source) => (
              <a href={safeExternalUrl(source.url)} target="_blank" rel="noopener noreferrer" class="text-[var(--accent)] hover:underline">
                {source.sourceName}
              </a>
            ))}
            {tip.author && (
              <>
                <span>·</span>
                <span>{tip.author}</span>
              </>
            )}
            {formattedDate && (
              <>
                <span>·</span>
                <span>{formattedDate}</span>
              </>
            )}
          </div>

          <!-- Headline -->
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[var(--text-primary)] tracking-tight leading-snug" id="tip-headline">
            {titleText}
          </h1>

          <!-- Category & Tag Pills + Difficulty -->
          <div class="flex items-center gap-2 flex-wrap text-xs font-mono">
            {tipCategories.map((cat) => {
              const catHref = isNewsItem
                ? `/${lang}/news?cat=${encodeURIComponent(cat)}`
                : validCategoryIds.has(cat)
                  ? `/${lang}/category/${encodeURIComponent(cat)}`
                  : `/${lang}?q=${encodeURIComponent(cat)}`;
              return (
                <a
                  href={catHref}
                  class="px-2 py-0.5 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--accent)] hover:border-[var(--accent-border)] hover:bg-[var(--accent-bg)] transition-colors"
                >
                  #{cat}
                </a>
              );
            })}
            {tipTags.map((tag) => (
              <a
                href={isNewsItem ? `/${lang}/news?q=${encodeURIComponent(tag)}` : `/${lang}?q=${encodeURIComponent(tag)}`}
                class="px-2 py-0.5 rounded-md border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-muted)] hover:text-[var(--accent)] hover:border-[var(--accent-border)] hover:bg-[var(--accent-bg)] transition-colors"
              >
                #{tag}
              </a>
            ))}
            {tip.difficulty && (
              <span class="text-[var(--text-secondary)] font-semibold ml-1">
                {isVi ? 'Độ khó:' : 'Difficulty:'} {t.difficulty[tip.difficulty]}
              </span>
            )}
          </div>

          <!-- Bilingual Tabs Toggle -->
          {tip.original_lang !== lang && (
            <div class="inline-flex p-0.5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] text-xs font-mono" id="bilingual-tabs">
              <button
                id="tab-localized"
                type="button"
                class="px-3 py-1.5 rounded-lg transition-all bg-[var(--accent-hero)] text-[#15110A] font-bold shadow-sm"
              >
                {isVi ? 'Tiếng Việt' : 'English'}{' '}
                {isMachineTranslated
                  ? (isVi ? '(dịch tự động)' : '(machine translated)')
                  : isUntranslated
                    ? (isVi ? '(chưa dịch)' : '(not translated)')
                    : ''}
              </button>
              <button
                id="tab-orig"
                type="button"
                class="px-3 py-1.5 rounded-lg transition-all text-[var(--text-muted)] hover:text-[var(--text-primary)]"
              >
                {origLangLabel}
              </button>
            </div>
          )}

          <!-- Key Takeaways Callout -->
          {keyPoints.length > 0 && (
            <section
              class="rounded-xl border border-[var(--accent-border)] bg-[var(--accent-bg)] p-5"
              aria-label={isVi ? 'Tóm tắt nhanh' : 'Key Takeaways'}
            >
              <h2 class="text-[11px] font-mono font-bold tracking-wider text-[var(--accent)] uppercase mb-3 flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <span>{isVi ? 'Tóm tắt nhanh' : 'Key Takeaways'}</span>
                <span id="tip-key-points-lang-note" class="text-[10px] opacity-80">{keyPointsInitialNote}</span>
              </h2>
              <ul class="space-y-2 text-sm sm:text-base text-[var(--text-primary)] leading-relaxed" id="tip-key-points-list">
                {keyPoints.map((point) => (
                  <li class="flex items-start gap-2.5">
                    <span class="mt-2 w-1.5 h-1.5 rounded-full bg-[var(--accent)] shrink-0" aria-hidden="true"></span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}

          <!-- Summary Box -->
          <div class="rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-5">
            <h2 class="text-[11px] font-mono font-bold tracking-wider text-[var(--text-muted)] uppercase mb-2">
              {isVi ? 'TÓM TẮT' : 'SUMMARY'}
            </h2>
            <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed" id="tip-summary-text">
              {summaryText}
            </p>
          </div>

          <!-- Golden Callout Box -->
          <div class="rounded-2xl bg-[var(--accent-hero)] text-[#0e0f13] p-6 sm:p-7 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5 shadow-sm">
            <div class="space-y-1">
              <h2 class="font-bold text-lg text-[#0e0f13]">
                {isVi ? 'Bài đầy đủ nằm ở nguồn gốc' : 'Read the full article at the source'}
              </h2>
              <p class="text-xs sm:text-sm text-[#1c1d22] font-medium leading-relaxed max-w-md">
                {isVi
                  ? `Hãy đọc tại ${tip.source.name} để ủng hộ tác giả và xem đủ các bước hướng dẫn.`
                  : `Support the original author and follow the complete walkthrough on ${tip.source.name}.`}
              </p>
            </div>

            <a
              href={safeExternalUrl(tip.url)}
              target="_blank"
              rel="noopener noreferrer"
              class="shrink-0 px-5 py-2.5 rounded-xl bg-[#0e0f13] text-white hover:bg-zinc-800 transition-colors font-bold text-xs inline-flex items-center gap-1.5 shadow-sm"
            >
              <span>{isVi ? `Đọc bài gốc tại ${tip.source.name} ↗` : `Read original on ${tip.source.name} ↗`}</span>
            </a>
          </div>

          <!-- Action Row -->
          <div class="flex items-center gap-2 pt-2 text-xs font-mono flex-wrap">
            <button
              type="button"
              class="bookmark-btn px-3 py-1.5 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] transition-all inline-flex items-center gap-1.5"
              data-id={tip.id}
              aria-pressed="false"
            >
              <span data-bookmark-label>{isVi ? 'Lưu để xem sau' : 'Save for later'}</span>
            </button>

            <button
              type="button"
              id="share-btn"
              class="px-3 py-1.5 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] hover:text-[var(--text-primary)] transition-all"
              data-url={pageCanonicalUrl}
            >
              {isVi ? 'Chia sẻ' : 'Share'}
            </button>

            <a
              href={`https://github.com/nhattranhuynhthien/tech-tips-hub/issues/new?title=${encodeURIComponent(`Report Translation Issue ${tip.id}`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] hover:text-[var(--text-primary)] transition-all"
            >
              {isVi ? 'Báo lỗi dịch' : 'Report translation'}
            </a>

            <a
              href={reportBrokenLinkUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:border-[var(--border-strong)] hover:text-[var(--text-primary)] transition-all"
            >
              {isVi ? 'Báo link hỏng' : 'Report broken link'}
            </a>
          </div>
        </article>

        <!-- Right 1 Col: Sidebar -->
        <aside class="space-y-6">
          {relatedTips.length > 0 && (
            <div class="rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-5">
              <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--text-muted)] mb-4">
                {isVi ? 'CÙNG CHỦ ĐỀ' : 'RELATED TIPS'}
              </h2>
              <ul class="space-y-4">
                {relatedTips.map((r) => (
                  <li class="border-b border-[var(--border-subtle)] pb-3 last:border-b-0 last:pb-0">
                    <a
                      href={`/${lang}/tip/${encodeURIComponent(r.slug || r.id)}`}
                      class="text-xs sm:text-sm font-bold text-[var(--text-primary)] hover:text-[var(--accent)] transition-colors leading-snug block mb-1"
                    >
                      {r.title[lang] || r.title['en'] || Object.values(r.title)[0] || ''}
                    </a>
                    <span class="text-[11px] font-mono text-[var(--text-muted)]">
                      {r.source.name}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-5">
            <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--text-muted)] mb-3">
              {isVi ? 'VỀ BẢN TÓM TẮT NÀY' : 'ABOUT THIS SUMMARY'}
            </h2>
            <p class="text-xs font-mono text-[var(--text-secondary)] leading-relaxed">
              {isVi
                ? 'Tech Tips Hub chỉ lưu tiêu đề và tóm tắt ngắn. Bản dịch tự động có thể chưa chính xác; hãy đối chiếu với bài gốc.'
                : 'Tech Tips Hub only indexes titles and concise summaries. Machine translations may contain imperfections; always verify against the source article.'}
            </p>
          </div>
        </aside>
      </div>
    </div>

    <script
      is:inline
      define:vars={{
        lang,
        tipId: tip.id,
        titleText,
        origTitle,
        summaryText,
        origSummary,
        keyPoints,
        origKeyPoints,
        keyPointsInitialNote,
        keyPointsOrigNote,
      }}
    >
      (function () {
        const isVi = lang === 'vi';
        if (window.TechTipsActions) {
          window.TechTipsActions.markRead(tipId);
        } else {
          window.addEventListener('DOMContentLoaded', () => window.TechTipsActions?.markRead(tipId));
        }

        const tabLocalized = document.getElementById('tab-localized');
        const tabOrig = document.getElementById('tab-orig');
        const headline = document.getElementById('tip-headline');
        const summary = document.getElementById('tip-summary-text');
        const keyPointsList = document.getElementById('tip-key-points-list');
        const keyPointsNote = document.getElementById('tip-key-points-lang-note');
        const shareBtn = document.getElementById('share-btn');

        function renderKeyPoints(points, note) {
          if (keyPointsNote) keyPointsNote.textContent = note || '';
          if (!keyPointsList || !Array.isArray(points) || !points.length) return;
          const frag = document.createDocumentFragment();
          points.forEach((point) => {
            const li = document.createElement('li');
            li.className = 'flex items-start gap-2.5';
            const dot = document.createElement('span');
            dot.className = 'mt-2 w-1.5 h-1.5 rounded-full bg-[var(--accent)] shrink-0';
            dot.setAttribute('aria-hidden', 'true');
            const text = document.createElement('span');
            text.textContent = point;
            li.append(dot, text);
            frag.appendChild(li);
          });
          keyPointsList.replaceChildren(frag);
        }

        tabLocalized?.addEventListener('click', () => {
          tabLocalized.className = 'px-3 py-1.5 rounded-lg transition-all bg-[var(--accent-hero)] text-[#15110A] font-bold shadow-sm';
          if (tabOrig) tabOrig.className = 'px-3 py-1.5 rounded-lg transition-all text-[var(--text-muted)] hover:text-[var(--text-primary)]';
          if (headline) headline.textContent = titleText;
          if (summary) summary.textContent = summaryText;
          renderKeyPoints(keyPoints, keyPointsInitialNote);
        });

        tabOrig?.addEventListener('click', () => {
          tabOrig.className = 'px-3 py-1.5 rounded-lg transition-all bg-[var(--accent-hero)] text-[#15110A] font-bold shadow-sm';
          if (tabLocalized) tabLocalized.className = 'px-3 py-1.5 rounded-lg transition-all text-[var(--text-muted)] hover:text-[var(--text-primary)]';
          if (headline) headline.textContent = origTitle;
          if (summary) summary.textContent = origSummary;
          renderKeyPoints(origKeyPoints, keyPointsOrigNote);
        });

        function notifyShare(ok) {
          const copiedMsg = isVi ? 'Đã sao chép liên kết' : 'Link copied to clipboard';
          const failMsg = isVi ? 'Không thể sao chép liên kết' : 'Failed to copy link';
          window.TechTipsActions?.showToast?.(ok ? copiedMsg : failMsg, ok ? undefined : 'error');
          if (ok && shareBtn) {
            const prev = shareBtn.textContent;
            shareBtn.textContent = isVi ? 'Đã sao chép!' : 'Copied!';
            setTimeout(() => {
              shareBtn.textContent = prev || (isVi ? 'Chia sẻ' : 'Share');
            }, 2000);
          }
        }

        shareBtn?.addEventListener('click', async () => {
          const url = shareBtn.getAttribute('data-url') || window.location.href;
          const isTouch = window.matchMedia && window.matchMedia('(pointer: coarse)').matches;
          if (isTouch && typeof navigator.share === 'function') {
            try {
              await navigator.share({ title: titleText, url });
              return;
            } catch (err) {
              if (err && err.name === 'AbortError') return;
            }
          }
          if (window.TechTipsActions && typeof window.TechTipsActions.copyText === 'function') {
            const ok = await window.TechTipsActions.copyText(url);
            notifyShare(ok);
            return;
          }
          if (navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
            try {
              await navigator.clipboard.writeText(url);
              notifyShare(true);
              return;
            } catch {}
          }
          notifyShare(false);
        });
      })();
    </script>
  </Layout>
) : (
  <html lang={lang}>
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>{titleText ? `${titleText} — tips.hub` : 'tips.hub'}</title>
      <meta name="robots" content="noindex, follow" />
      <link rel="canonical" href={pageCanonicalUrl} />
      <meta http-equiv="refresh" content={`0; url=${canonicalRelativePath}`} />
      <script is:inline define:vars={{ canonicalRelativePath }}>
        window.location.replace(canonicalRelativePath);
      </script>
    </head>
    <body style="background:#0F1114;color:#ECEAE4;font-family:system-ui,-apple-system,sans-serif;display:flex;min-height:100vh;align-items:center;justify-content:center;margin:0;padding:1.5rem;text-align:center">
      <p>
        {isVi ? 'Đang chuyển hướng tới ' : 'Redirecting to '}
        <a href={canonicalRelativePath} style="color:#FFB547">{titleText || canonicalRelativePath}</a>…
      </p>
    </body>
  </html>
)}
