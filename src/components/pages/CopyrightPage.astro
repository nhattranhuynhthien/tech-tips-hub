---
import Layout from '../../layouts/Layout.astro';
import type { Locale } from '../../lib/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const isVi = lang === 'vi';

const takedownParams = new URLSearchParams({
  title: '[Takedown] ',
  body: (isVi
    ? [
        '## Yêu cầu gỡ bài / chặn nguồn',
        '',
        '- **URL bài viết hoặc tên miền nguồn:** ',
        '- **Vai trò của bạn (tác giả / đại diện nhà xuất bản):** ',
        '- **Ghi chú thêm (nếu có):** ',
      ]
    : [
        '## Copyright Takedown / Source Exclusion Request',
        '',
        '- **Article URL or Publisher Domain:** ',
        '- **Your Role (Author / Publisher Representative):** ',
        '- **Additional Notes (optional):** ',
      ]
  ).join('\n'),
});
const takedownIssueUrl = `https://github.com/nhattranhuynhthien/tech-tips-hub/issues/new?${takedownParams.toString()}`;
---

<Layout
  lang={lang}
  title={isVi ? 'Chính sách Bản quyền & Gỡ bài' : 'Copyright Policy & Takedown'}
  description={isVi
    ? 'Quy định về tôn trọng bản quyền tác giả, mô hình tổng hợp tin hợp pháp và quy trình gỡ bỏ bài viết theo yêu cầu.'
    : 'Policies regarding original creator attribution, legal aggregation boundaries, and takedown procedures.'}
  canonicalPath={`/${lang}/copyright`}
>
  <article class="max-w-4xl mx-auto space-y-8">
    <header class="pb-6 border-b border-[var(--border-color)]">
      <div class="text-xs font-mono font-bold text-[var(--accent)] mb-2">
        $ legal --copyright-policy
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[var(--text-primary)] tracking-tight mb-3">
        {isVi ? 'Chính sách Bản quyền & Quy trình Gỡ bài' : 'Copyright Policy & Takedown Procedure'}
      </h1>
      <p class="text-sm text-[var(--text-secondary)] leading-relaxed font-mono">
        {isVi
          ? 'Chúng tôi cam kết tuân thủ nghiêm ngặt quyền sở hữu trí tuệ của tác giả và các cơ quan báo chí, xuất bản.'
          : 'We are committed to respecting the intellectual property rights of creators and publishing organizations.'}
      </p>
    </header>

    <div class="space-y-6 text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed font-sans">
      <section class="rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-6 space-y-3">
        <h2 class="text-base font-bold text-[var(--text-primary)] font-mono">
          {isVi ? '# 1. Mô hình Aggregator (Tổng hợp & Dẫn link)' : '# 1. Aggregator Model (Fair Use & Direct Attribution)'}
        </h2>
        <p>
          {isVi
            ? 'tips.hub vận hành hoàn toàn theo mô hình tổng hợp thông tin tóm tắt (Content Aggregator):'
            : 'tips.hub operates strictly as an excerpt aggregator:'}
        </p>
        {isVi ? (
          <ul class="list-disc list-inside space-y-2 text-xs font-mono text-[var(--text-secondary)] pl-2">
            <li><strong class="text-[var(--text-primary)]">Không sao chép nguyên bài:</strong> Website tuyệt đối không đăng tải lại toàn bộ nội dung bài viết. Chúng tôi chỉ trích xuất tiêu đề và đoạn tóm tắt ngắn (thường từ 1-2 câu).</li>
            <li><strong class="text-[var(--text-primary)]">Luôn dẫn nguồn trực tiếp:</strong> Mọi bài viết đều có nút "Đọc bài gốc" đưa người đọc trực tiếp về URL của trang báo hoặc blog gốc.</li>
            <li><strong class="text-[var(--text-primary)]">Không lưu trữ hình ảnh:</strong> Chúng tôi không cào hay re-host các file ảnh hoặc tài sản truyền thông của nguồn.</li>
            <li><strong class="text-[var(--text-primary)]">Tuân thủ Robots.txt:</strong> Trình thu thập tự động chỉ truy cập các luồng RSS/Atom được nhà xuất bản công khai và tôn trọng các chỉ thị cấm cào.</li>
          </ul>
        ) : (
          <ul class="list-disc list-inside space-y-2 text-xs font-mono text-[var(--text-secondary)] pl-2">
            <li><strong class="text-[var(--text-primary)]">No Full-Text Copying:</strong> We never reproduce full articles. Only standardized titles and short excerpts are indexed.</li>
            <li><strong class="text-[var(--text-primary)]">Always Direct Links:</strong> Every entry links directly to the canonical source URL.</li>
            <li><strong class="text-[var(--text-primary)]">No Image Re-hosting:</strong> We do not download or re-host source article images.</li>
            <li><strong class="text-[var(--text-primary)]">Robots.txt Adherence:</strong> Our crawlers only process public RSS/Atom feeds and honor crawl-delay directives.</li>
          </ul>
        )}
      </section>

      <section class="rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-6 space-y-3">
        <h2 class="text-base font-bold text-[var(--text-primary)] font-mono">
          {isVi ? '# 2. Bản dịch tự động' : '# 2. Machine Translations'}
        </h2>
        <p>
          {isVi
            ? 'Các bản dịch tiêu đề và tóm tắt sang tiếng Việt hoặc tiếng Anh là sản phẩm xử lý máy móc hỗ trợ độc giả tiếp cận kiến thức nhanh chóng. Các bản dịch này được gắn nhãn minh bạch "Bản dịch tự động". Nếu có bất kỳ sự sai lệch ngữ nghĩa nào so với nguyên tác, bài viết gốc của tác giả luôn là tiêu chuẩn duy nhất và chính xác nhất.'
            : 'Translations are automated machine outputs clearly labeled "Machine translated" to help readers across languages. If any nuance is lost, the original author\'s article is always the sole authority.'}
        </p>
      </section>

      <section class="rounded-xl border border-[var(--border-color)] bg-[var(--bg-surface)] p-6 space-y-4">
        <h2 class="text-base font-bold text-[var(--text-primary)] font-mono">
          {isVi ? '# 3. Quy trình Yêu cầu Gỡ bài (Takedown Request)' : '# 3. Takedown Requests'}
        </h2>
        <p>
          {isVi
            ? 'Nếu bạn là tác giả hoặc đại diện hợp pháp của nguồn xuất bản và không muốn bài viết hoặc tên miền của mình xuất hiện trên tips.hub, vui lòng tạo yêu cầu gỡ bài trực tiếp qua GitHub Issue (đã điền sẵn biểu mẫu):'
            : 'If you are an author or publisher representative and want specific URLs or your entire domain excluded from tips.hub, please open a prefilled Takedown Issue on GitHub:'}
        </p>
        <div>
          <a
            href={takedownIssueUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-[var(--accent-hero)] text-[#15110A] hover:opacity-90 transition-opacity font-mono font-bold text-xs"
          >
            <span>{isVi ? 'Gửi yêu cầu gỡ bài trên GitHub ↗' : 'Submit Takedown Request on GitHub ↗'}</span>
          </a>
        </div>
        <p class="text-xs font-mono text-[var(--accent)]">
          {isVi
            ? 'Chúng tôi cam kết tiếp nhận và gỡ bỏ toàn bộ liên kết liên quan trong vòng 24–48 giờ làm việc.'
            : 'We process and remove all requested links within 24–48 business hours.'}
        </p>
      </section>
    </div>
  </article>
</Layout>
