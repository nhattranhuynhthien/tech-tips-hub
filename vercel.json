{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/telegram.ts": { "maxDuration": 60 }
  },
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "cookie", "key": "techtips_lang", "value": "vi" }],
      "destination": "/vi",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "cookie", "key": "techtips_lang", "value": "en" }],
      "destination": "/en",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "^[eE][nN]([,-]|$).*" }],
      "destination": "/en",
      "permanent": false
    }
  ]
}
